# Public identifiers, not credentials. Obtain these from the JDPI Sanity project.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Optional override for a custom domain. Leave blank on Vercel to use its production domain.
PUBLIC_SITE_URL=
PUBLIC_SANITY_STUDIO_URL=
# snapshot: reproducible release from committed content; sanity: fetch published content at build time.
CONTENT_SOURCE=snapshot
# Organisation-approved hosted checkouts only. Blank leaves a truthful pending state.
PUBLIC_PAYSTACK_DONATION_URL=
PUBLIC_FLUTTERWAVE_DONATION_URL=
# Separate approved recurring checkout links; one-time links are never reused for monthly giving.
PUBLIC_PAYSTACK_MONTHLY_DONATION_URL=
PUBLIC_FLUTTERWAVE_MONTHLY_DONATION_URL=
# Server/build-only tokens. Never prefix these with PUBLIC_.
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
