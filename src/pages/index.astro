---
import {getContent} from '../lib/content';
import Layout from '../layouts/SiteLayout.astro';
import ContentCards from '../components/ContentCards.astro';
import ContentImage from '../components/ContentImage.astro';
const content=await getContent();const {home,programmes,projects,stories,partners}=content;
const background=(image:{url:string},overlay:string)=>`background-image:${overlay},url("${image.url}")`;
---
<Layout content={content} home>
  <section class="hero" id="hero" style={background(home.heroImage,'linear-gradient(90deg,rgba(0,0,0,.86) 0%,rgba(0,0,0,.62) 43%,rgba(0,0,0,.08) 76%)')}><div class="hero-content"><p class="hero-kicker">{home.heroKicker}</p><h1>{home.heroStatement} <span>{home.heroHighlight}</span></h1><p class="hero-copy">{home.heroIntro}</p><div class="hero-actions"><a class="btn" href="#what-we-do">EXPLORE OUR WORK →</a><a class="btn secondary" href="#impact">OUR IMPACT →</a></div><p class="location"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>{home.location}</p></div></section>
  <section class="who" id="who-we-are"><div class="shell who-grid"><div class="who-copy"><p class="eyebrow">WHO WE ARE</p><p>{home.aboutIntro}</p><a class="text-link" href="#contact">LEARN MORE ABOUT JDPI →</a></div><ContentImage image={home.aboutImage}/></div></section>
  <section class="impact" id="impact" style={background(home.impactImage,'linear-gradient(rgba(0,0,0,.67),rgba(0,0,0,.67))')}><div class="impact-inner"><h2>OUR IMPACT AT A GLANCE</h2><div class="impact-stats">{home.impactFacts.map(fact=><div class="impact-stat"><strong>{fact.value}</strong><span>{fact.label}</span></div>)}</div><a class="btn" href="/projects/">SEE OUR IMPACT →</a></div></section>
  <section class="section" id="what-we-do"><div class="shell"><div class="section-head"><p class="eyebrow">WHAT WE DO</p><h2>{home.programmeHeading}</h2></div><div class="carousel-wrap"><ContentCards items={programmes} type="programmes"/><button class="carousel-btn prev" data-carousel="programmes-carousel" data-direction="-1" aria-label="Previous programmes">‹</button><button class="carousel-btn next" data-carousel="programmes-carousel" data-direction="1" aria-label="Next programmes">›</button></div></div></section>
  <section class="section projects" id="projects"><div class="shell"><div class="split-head"><div><p class="eyebrow">FEATURED PROJECTS</p><h2>{home.projectsHeading}</h2></div><a class="text-link" href="/projects/">VIEW ALL PROJECTS →</a></div><div class="carousel-wrap"><ContentCards items={projects} type="projects"/><button class="carousel-btn prev" data-carousel="projects-carousel" data-direction="-1" aria-label="Previous projects">‹</button><button class="carousel-btn next" data-carousel="projects-carousel" data-direction="1" aria-label="Next projects">›</button></div></div></section>
  <section class="section stories" id="stories"><div class="shell"><div class="split-head"><div><p class="eyebrow">STORIES &amp; UPDATES</p><h2>{home.storiesHeading}</h2></div><a class="text-link" href="/stories/">VIEW ALL STORIES →</a></div><div class="filters" role="group" aria-label="Filter stories">{['All','Stories','News','Events','Publications'].map((type,i)=><button class:list={['filter',{active:i===0}]} data-filter={type} aria-pressed={i===0}>{type}</button>)}</div><ContentCards items={stories} type="stories"/></div></section>
  <section class="partners" id="resources"><div class="shell"><h2>{home.partnersHeading}</h2><p>{home.partnersIntro}</p><div class="partner-track">{partners.map(partner=><div class="partner">{partner.logo?.url ? <ContentImage image={partner.logo}/> : partner.name}</div>)}</div></div></section>
  <section class="support" id="donate"><div class="shell support-grid"><div class="support-image"><ContentImage image={home.supportImage}/></div><div class="support-copy"><p class="eyebrow">YOUR SUPPORT CAN</p><h2>Make a Difference</h2><p>{home.supportIntro}</p><div class="support-actions"><a class="btn" href="/donate/">DONATE NOW →</a><a class="text-link" href="#contact">Other ways to support →</a></div></div></div></section>
</Layout>
