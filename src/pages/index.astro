---
import {getContent} from '../lib/content';
import Layout from '../layouts/SiteLayout.astro';
import ContentCards from '../components/ContentCards.astro';
import ContentImage from '../components/ContentImage.astro';
import PartnerCarousel from '../components/PartnerCarousel.astro';
const content=await getContent();const {home,programmes,projects,stories,partners}=content;
const background=(image:{url:string},overlay:string)=>`background-image:${overlay},url("${image.url}")`;
const partnerLogos:Record<string,string>={
  'German Cooperation / BMZ':'/assets/partners/bmz.jpg',
  'Caritas Germany':'/assets/wordpress/caritas-germany.avif',
  'KfW':'/assets/wordpress/kfw.avif',
  'Catholic Relief Services':'/assets/partners/crs.png',
  'Nigeria Humanitarian Fund':'/assets/wordpress/nhf.avif',
  'UNICEF':'/assets/wordpress/unicef.avif',
  'IOM':'/assets/partners/iom.svg'
};
// Focus labels describe existing summaries, not funding, status or location.
const projectFocus:Record<string,string>={
  'bmz-multisectoral-resilience-project':'Multisectoral resilience',
  'echf-into-mami-project':'Nutrition & WaSH',
  'nhf-integrated-nutrition-and-protection':'Nutrition & protection',
  'allright-project':'Protection & education'
};
const values=[
  {name:'Justice',text:'Advocating for the rights of the marginalised.',icon:'M12 3v18M5 21h14M4 7h16M6 7l-4 7h8L6 7Zm12 0-4 7h8l-4-7Z'},
  {name:'Development',text:'Building sustainable livelihoods.',icon:'M3 21h18M6 17v-5m6 5V8m6 9V3M4 8l6-4 5 1 5-4'},
  {name:'Peace',text:'Facilitating reconciliation and cohesion.',icon:'M12 3v18M12 12l-6 6m6-6 6 6M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z'},
  {name:'Faith-Based',text:'Grounded in Catholic Social Teaching.',icon:'M10 3h4v5h5v4h-5v9h-4v-9H5V8h5V3Z'}
];
---
<Layout content={content} home>
  <section class="hero" id="hero" style={background(home.heroImage,'linear-gradient(90deg,rgba(0,0,0,.86) 0%,rgba(0,0,0,.62) 43%,rgba(0,0,0,.08) 76%)')}><div class="hero-content"><p class="hero-kicker">{home.heroKicker}</p><h1>{home.heroStatement} <span>{home.heroHighlight}</span></h1><p class="hero-copy">{home.heroIntro}</p><div class="hero-actions"><a class="btn" href="#what-we-do">EXPLORE OUR WORK →</a><a class="btn secondary" href="/impact/">OUR IMPACT →</a></div><p class="location"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>{home.location}</p></div></section>
<section class="who" id="who-we-are" aria-labelledby="about-heading"><div class="shell"><div class="who-grid"><div class="who-copy"><p class="eyebrow">WHO WE ARE</p><h2 id="about-heading">Serving communities.<br/><span>Upholding dignity.</span></h2><p>{home.aboutIntro}</p><p class="history-note">Established in 1971 as the Social Welfare Apostolate, our work is rooted in Catholic Social Teaching.</p><a class="text-link" href="/about/">LEARN MORE ABOUT JDPI</a></div><div class="about-photos"><img class="about-main" src="/assets/wordpress/about-farming.avif" alt="A woman tending crops in a field" width="800" height="534" loading="lazy"/><div class="heritage-label"><strong>Since 1971</strong><span>Serving the poor and marginalised</span></div><img class="about-inset" src="/assets/wordpress/about-assistance.avif" alt="A man holding a food assistance package at a community gathering" width="800" height="534" loading="lazy"/></div></div><div class="values-grid" aria-label="Our guiding values">{values.map(value=><article class="value-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={value.icon}/></svg><div><h3>{value.name}</h3><p>{value.text}</p></div></article>)}</div></div></section>
  <section class="impact" id="impact" style={background(home.impactImage,'linear-gradient(rgba(0,0,0,.67),rgba(0,0,0,.67))')}><div class="impact-inner"><h2>OUR IMPACT AT A GLANCE</h2><div class="impact-stats">{home.impactFacts.map(fact=><div class="impact-stat"><strong>{fact.value}</strong><span>{fact.label}</span></div>)}</div><a class="btn" href="/impact/">SEE OUR IMPACT →</a></div></section>
  <section class="section" id="what-we-do"><div class="shell"><div class="section-head"><p class="eyebrow">WHAT WE DO</p><h2>{home.programmeHeading}</h2><a class="text-link" href="/programmes/">VIEW ALL PROGRAMMES →</a></div><div class="carousel-wrap"><ContentCards items={programmes} type="programmes"/><button class="carousel-btn prev" data-carousel="programmes-carousel" data-direction="-1" aria-label="Previous programmes">‹</button><button class="carousel-btn next" data-carousel="programmes-carousel" data-direction="1" aria-label="Next programmes">›</button></div></div></section>
  <section class="section projects" id="projects"><div class="shell"><div class="split-head"><div><p class="eyebrow">FEATURED PROJECTS</p><h2>{home.projectsHeading}</h2></div><a class="text-link" href="/projects/">VIEW ALL PROJECTS</a></div><div class="carousel-wrap"><ContentCards items={projects} type="projects" focusLabels={projectFocus}/><button class="carousel-btn prev" data-carousel="projects-carousel" data-direction="-1" aria-label="Previous projects">‹</button><button class="carousel-btn next" data-carousel="projects-carousel" data-direction="1" aria-label="Next projects">›</button></div></div></section>
  <section class="section stories" id="stories"><div class="shell"><div class="split-head"><div><p class="eyebrow">STORIES &amp; UPDATES</p><h2>{home.storiesHeading}</h2></div><a class="text-link" href="/stories/">VIEW ALL STORIES →</a></div><div class="filters" role="group" aria-label="Filter stories">{['All','Stories',...(stories.some(item=>item.category==='Blogs')?['Blogs']:[]),'News','Events','Publications'].map((type,i)=><button class:list={['filter',{active:i===0}]} data-filter={type} aria-pressed={i===0}>{type==='Blogs'?'Blog posts':type}</button>)}</div><ContentCards items={stories} type="stories"/></div></section>
  <section class="partners" id="resources"><div class="shell"><h2>{home.partnersHeading}</h2><p>{home.partnersIntro}</p><PartnerCarousel partners={partners} logos={partnerLogos}/></div></section>
  <section class="support" id="donate"><div class="shell support-grid"><div class="support-image"><ContentImage image={home.supportImage}/></div><div class="support-copy"><p class="eyebrow">YOUR SUPPORT CAN</p><h2>Make a Difference</h2><p>{home.supportIntro}</p><div class="support-actions"><a class="btn" href="/donate/">DONATE NOW</a><a class="btn secondary" href="mailto:info@jdpimaiduguri.org?subject=Partnership%20enquiry">PARTNER WITH US</a><a class="text-link" href="mailto:info@jdpimaiduguri.org?subject=Volunteering%20enquiry">Explore volunteering</a></div></div></div></section>
</Layout>
