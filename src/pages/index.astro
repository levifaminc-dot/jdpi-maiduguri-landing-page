---
import {getContent} from '../lib/content';
import Layout from '../layouts/SiteLayout.astro';
import ContentCards from '../components/ContentCards.astro';
import ContentImage from '../components/ContentImage.astro';
import '../styles/landing-redesign.css';
const content=await getContent();const {home,programmes,projects,stories,partners}=content;
// Reuse the supplied nutrition story photo instead of the mismatched imported woodland asset.
const nutritionImage=stories.find(story=>story.slug==='how-tom-brown-sessions-are-changing-lives-in-wumu')?.image;
const landingProgrammes=programmes.map(programme=>programme.slug==='nutrition'&&nutritionImage ? {...programme,image:nutritionImage} : programme);
---
<Layout content={content} home>
  <section class="hero" id="hero">
    <div class="hero-content"><p class="hero-kicker">{home.heroKicker}</p><h1>{home.heroStatement} <span>{home.heroHighlight}.</span></h1><p class="hero-copy">{home.heroIntro}</p><div class="hero-actions"><a class="btn" href="#what-we-do">Explore our work</a><a class="btn secondary" href="#impact">See our impact</a></div><p class="location"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>Borno · Adamawa · Yobe</p></div>
    <div class="hero-portrait"><ContentImage image={home.heroImage} eager/><div class="portrait-caption"><span>People first. Always.</span><span>NORTHEAST NIGERIA</span></div></div>
  </section>
  <div class="identity-strip shell"><p>The humanitarian and development organisation of the <strong>Catholic Diocese of Maiduguri.</strong></p><span>Justice. Development. Peace.</span></div>
  <section class="who" id="who-we-are"><div class="shell who-grid">
    <div class="about-visual"><ContentImage image={home.aboutImage}/><div class="history-note"><strong>Since 1971</strong><span>Serving people.<br/>Strengthening communities.</span></div></div>
    <div class="who-copy"><p class="eyebrow">WHO WE ARE</p><h2>Rooted in faith.<br/>Working for people.</h2><p>{home.aboutIntro}</p><div class="values-line"><span>Justice</span><span>Development</span><span>Peace</span></div><a class="text-link" href="#contact">Get to know JDPI</a></div>
  </div></section>
  <section class="impact" id="impact"><div class="shell impact-inner"><div class="impact-heading"><p class="eyebrow">OUR IMPACT</p><h2>Working together.<br/>Reaching further.</h2><a class="text-link" href="/projects/">Explore our projects</a></div><div class="impact-stats">{home.impactFacts.map(fact=><div class="impact-stat"><strong>{fact.value}</strong><span>{fact.label}</span></div>)}</div></div></section>
  <section class="section programmes" id="what-we-do"><div class="shell"><div class="split-head"><div><p class="eyebrow">WHAT WE DO</p><h2>{home.programmeHeading}</h2></div><div class="carousel-controls"><button class="carousel-btn prev" data-carousel="programmes-carousel" data-direction="-1" aria-label="Previous programmes">‹</button><button class="carousel-btn next" data-carousel="programmes-carousel" data-direction="1" aria-label="Next programmes">›</button></div></div><div class="carousel-wrap"><ContentCards items={landingProgrammes} type="programmes"/></div></div></section>
  <section class="section projects" id="projects"><div class="shell"><div class="split-head"><div><p class="eyebrow">FEATURED PROJECTS</p><h2>{home.projectsHeading}</h2></div><a class="text-link" href="/projects/">View all projects</a></div><ContentCards items={projects} type="projects" carousel={false}/></div></section>
  <section class="section stories" id="stories"><div class="shell"><div class="split-head"><div><p class="eyebrow">STORIES &amp; UPDATES</p><h2>{home.storiesHeading}</h2></div><a class="text-link" href="/stories/">View all stories</a></div><div class="filters" role="group" aria-label="Filter stories">{['All','Stories','News','Events','Publications'].map((type,i)=><button class:list={['filter',{active:i===0}]} data-filter={type} aria-pressed={i===0}>{type}</button>)}</div><ContentCards items={stories} type="stories" carousel={false}/><p id="stories-empty" class="stories-empty" hidden>No updates in this category yet. Explore our other stories.</p></div></section>
  <section class="partners" id="resources"><div class="shell"><p class="eyebrow">STRONGER TOGETHER</p><h2>{home.partnersHeading}</h2><p>{home.partnersIntro}</p><div class="partner-track">{partners.map(partner=><div class="partner">{partner.logo?.url ? <ContentImage image={partner.logo}/> : partner.name}</div>)}</div></div></section>
  <section class="support" id="donate"><div class="shell support-grid"><div class="support-image"><ContentImage image={home.supportImage}/></div><div class="support-copy"><p class="eyebrow">GET INVOLVED</p><h2>A more dignified future<br/>starts with all of us.</h2><p>{home.supportIntro}</p><div class="support-actions"><a class="btn" href="/donate/">Support our work</a><a class="text-link" href="#contact">Partner or volunteer</a></div></div></div></section>
</Layout>
