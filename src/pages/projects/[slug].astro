---
import {getContent} from '../../lib/content';
import ProjectDetailPage from '../../components/ProjectDetailPage.astro';
export async function getStaticPaths(){const content=await getContent();return content.projects.map(item=>({params:{slug:item.slug},props:{item,content}}));}
const {item,content}=Astro.props;
---
<ProjectDetailPage item={item} content={content}/>
