---
import {getContent,formatDate,safeDownloadUrl} from '../../lib/content';
import Layout from '../../layouts/SiteLayout.astro';
const content=await getContent();
---
<Layout content={content} title={`Reports & Resources | ${content.settings.shortName}`}><section class="inner-page"><div class="shell"><p class="eyebrow">REPORTS &amp; RESOURCES</p><h1>Our work, documented.</h1>
{content.reports.length ? <div class="report-list">{content.reports.map(report=><article class="report"><h2>{report.title}</h2><p>{formatDate(report.publishedAt)}</p><p>{report.summary}</p>{safeDownloadUrl(report.fileUrl) && <a class="text-link" href={report.fileUrl} rel="noopener noreferrer">Download report</a>}</article>)}</div> : <div class="notice"><p>For JDPI publications and reports, please contact our team.</p><a class="text-link" href={`mailto:${content.settings.email}`}>{content.settings.email}</a></div>}
</div></section></Layout>
