---
import {pageEditor} from '../../lib/page-editor';
import {getContent,formatDate} from '../../lib/content';
import {openVacancies} from '../../lib/careers';
import Layout from '../../layouts/SiteLayout.astro';
import '../../styles/careers.css';

const content=await getContent();
const page=pageEditor(content,'careers');
const jobs=openVacancies(content.vacancies);
const locations=[...new Set(jobs.map(job=>job.location))].sort();
const engagements=[...new Set(jobs.map(job=>job.engagement))].sort();
const focus=[
  {title:page.text('cultureOneTitle'),description:page.text('cultureOneText')},
  {title:page.text('cultureTwoTitle'),description:page.text('cultureTwoText')},
  {title:page.text('cultureThreeTitle'),description:page.text('cultureThreeText')},
];
const steps=[
  {number:'01',title:page.text('processOneTitle'),description:page.text('processOneText')},
  {number:'02',title:page.text('processTwoTitle'),description:page.text('processTwoText')},
  {number:'03',title:page.text('processThreeTitle'),description:page.text('processThreeText')},
];
---
<Layout content={content} title={`${page.text('seoTitle')} | ${content.settings.shortName}`} description={page.text('seoDescription')} pageClass="careers-page">
  <section class="career-hero" aria-labelledby="career-heading">
    <div class="career-hero-copy">
      <nav class="career-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Careers</span></nav>
      <p class="career-kicker">{page.text('heroKicker')}</p>
      <h1 id="career-heading">{page.text('heroTitle')}<br/><span>{page.text('heroAccent')}</span></h1>
      <p>{page.text('heroIntro')}</p>
      <a class="career-hero-link" href="#open-roles">Skip to vacancies <span aria-hidden="true">↓</span></a>
    </div>
    <figure class="career-hero-photo"><img src={page.image('heroImage').url} alt={page.image('heroImage').alt} width="1200" height="574" fetchpriority="high" decoding="async"/></figure>
  </section>

  <section class="career-openings" id="open-roles" aria-labelledby="career-openings-heading"><div class="career-shell">
    <div class="career-openings-head"><div><p class="career-kicker">{page.text('openingsKicker')}</p><h2 id="career-openings-heading" aria-label="Current vacancies">{page.text('openingsTitle')}</h2></div><p data-career-total>{jobs.length} {jobs.length===1?'role':'roles'} currently open</p></div>
    {jobs.length>0 && <p class="career-openings-intro">{page.text('openingsIntro')}</p>}
    {jobs.length>0 ? <div data-career-listing>
      <div class="career-controls" data-career-controls hidden>
        <label class="career-search">Search vacancies<input type="search" data-career-search placeholder="Job title, team or location" aria-controls="career-results"/></label>
        <label>Duty station<select data-career-location aria-controls="career-results"><option value="">All locations</option>{locations.map(location=><option value={location}>{location}</option>)}</select></label>
        <label>Engagement<select data-career-engagement aria-controls="career-results"><option value="">All types</option>{engagements.map(type=><option value={type}>{type}</option>)}</select></label>
      </div>
      <p class="career-results-count" data-career-count role="status" aria-live="polite">Showing {jobs.length} {jobs.length===1?'role':'roles'}</p>
      <div class="career-job-list" id="career-results">{jobs.map(job=><article class="career-job" data-career-job data-title={job.title} data-location={job.location} data-engagement={job.engagement} data-deadline={job.closingDate} data-search={`${job.title} ${job.department} ${job.location} ${job.referenceCode||''}`.toLowerCase()}>
        <div><p class="career-job-team">{job.department}</p><h3><a href={`/careers/${encodeURIComponent(job.slug)}/`}>{job.title}</a></h3><div class="career-job-meta"><span>{job.location}</span><span>{job.engagement}</span><span>Closes <time datetime={job.closingDate}>{formatDate(job.closingDate)}</time></span></div></div>
        <span class="career-job-arrow" aria-hidden="true">↗</span>
      </article>)}</div>
      <div class="career-filter-empty" data-career-filter-empty hidden><h3>No roles match those filters.</h3><p>Try another search or clear the filters.</p><button type="button" data-career-reset>Clear filters</button></div>
      <noscript><p>All current opportunities are shown. Search and filters require JavaScript.</p></noscript>
    </div> : <div class="career-no-openings" role="status"><span class="career-no-openings-symbol" aria-hidden="true">↗</span><div><h3>{page.text('emptyTitle')}</h3><p>{page.text('emptyText')}</p></div></div>}
    <div class="career-access-banner" id="applicant-support"><div><h3>{page.text('accessTitle')}</h3><p>{page.text('accessText')}</p></div><a href="/contact/">Request application support <span aria-hidden="true">↗</span></a></div>
  </div></section>

  <section class="career-guidance career-shell" id="how-to-apply" aria-labelledby="career-process-heading">
    <div class="career-guidance-head"><p class="career-kicker">{page.text('processKicker')}</p><h2 id="career-process-heading">{page.text('processTitle')}</h2></div>
    <ol>{steps.map(step=><li><span aria-hidden="true">{step.number}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol>
  </section>

  <aside class="career-safety career-shell" aria-labelledby="career-safety-heading"><div><p class="career-kicker">APPLICATION SAFETY</p><h2 id="career-safety-heading">{page.text('safetyTitle')}</h2><p>{page.text('safetyText')}</p></div><a href="/contact/">Verify with JDPI <span aria-hidden="true">↗</span></a></aside>

  <details class="career-more career-shell" id="working-with-jdpi"><summary>{page.text('cultureTitle')} <span aria-hidden="true">＋</span></summary><div class="career-more-body"><p class="career-kicker">{page.text('cultureKicker')}</p><p>{page.text('cultureIntro')}</p><div class="career-focus-grid">{focus.map(item=><article><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></div></details>
  <script>import '../../scripts/careers-filter';</script>
</Layout>
