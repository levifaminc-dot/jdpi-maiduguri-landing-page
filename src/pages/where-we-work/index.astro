---
import {pageEditor} from "../../lib/page-editor";
import {getContent} from '../../lib/content';
import {getPublishedResources} from '../../lib/resources';
import Layout from '../../layouts/SiteLayout.astro';
import ImpactCoverageMaps from '../../components/ImpactCoverageMaps.astro';
import Icon from '../../components/ProjectIcon.astro';
import '../../styles/project-directory.css';
import '../../styles/impact-interactions.css';
import '../../styles/people-places.css';
const content=await getContent();
const page=pageEditor(content,"where-we-work");
const offices=page.data('offices',[{town:'Maiduguri',state:'Borno State',type:'Headquarters'},{town:'Mubi',state:'Adamawa State',type:'Office base'},{town:'Potiskum',state:'Yobe State',type:'Office base'}]);
const report=getPublishedResources(content).find(item=>item.title==='JDPI Annual Report 2025');
---
<Layout content={content} title={`${page.text("seoTitle")} | ${content.settings.shortName}`} description={page.text("seoDescription")} pageClass="projects-page people-place-page where-work-page">
  <section class="pp-hero" aria-labelledby="where-work-heading">
    <div class="pp-hero-copy"><nav class="pp-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/impact/">Our Impact</a><span>/</span><span aria-current="page">Where We Work</span></nav><p class="pp-kicker">{page.text("whereWorkParagraph1")}</p><h1 id="where-work-heading">{page.text("whereWorkHeading1")}<br/><span>{page.text("whereWorkText1")}</span></h1><p>{page.text("whereWorkParagraph2")}</p><a class="pp-button pp-light" href="#coverage-heading">{page.text("whereWorkLinkLabel1")} <Icon name="arrow"/></a></div>
    <figure><img src={page.image("whereWorkImage1").url} alt={page.image("whereWorkImage1").alt} width="1200" height="656" fetchpriority="high"/><figcaption>{page.text("whereWorkCaption1")}</figcaption></figure>
  </section>
  <div class="pp-footprint project-shell"><p><strong>{page.text("introText1")}</strong><span>{page.text("introText2")}</span></p><dl><div><dt>{page.text("introText3")}</dt><dd>3</dd></div><div><dt>{page.text("introText4")}</dt><dd>{page.text("introText5")}</dd></div><div><dt>{page.text("introText6")}</dt><dd>{page.text("introText7")}</dd></div></dl></div>
  <section class="pp-section project-shell" aria-labelledby="coverage-heading"><header class="pp-heading"><div><p class="pp-kicker">{page.text("coverageParagraph1")}</p><h2 id="coverage-heading">{page.text("coverageHeading1")}</h2></div><p>{page.text("coverageParagraph2")}</p></header><p class="pp-report-note">{page.text("coverageParagraph3")} <strong>{page.text("coverageText1")}</strong>{page.text("coverageParagraph4")}</p><ImpactCoverageMaps lgaActivities={page.data('lgaActivities',undefined)} impactYear={pageEditor(content,'impact').data('impactYear',2025)} showActivities reportUrl={report?.fileUrl} projectSlugs={content.projects.map(project=>project.slug)}/></section>
  <section class="pp-office-band" aria-labelledby="bases-heading"><div class="project-shell"><header class="pp-heading"><div><p class="pp-kicker">{page.text("basesParagraph1")}</p><h2 id="bases-heading">{page.text("basesHeading1")}</h2></div><a class="pp-text-link" href="/contact/#office-heading">{page.text("basesLinkLabel1")}</a></header><div class="pp-office-grid">{offices.map(({town,state,type})=><article><Icon name="location"/><div><small>{type}</small><h3>{town}</h3><p>{state}</p></div></article>)}</div><p class="pp-source">{page.text("basesParagraph2")}</p></div></section>
  <section class="pp-cta project-shell"><div><p class="pp-kicker">{page.text("introParagraph1")}</p><h2>{page.text("introHeading1")}</h2><p>{page.text("introParagraph2")}</p></div><a class="pp-button" href="/contact/">{page.text("introLinkLabel1")} <Icon name="arrow"/></a></section>
</Layout>
<script>import '../../scripts/impact-interactions';</script>
