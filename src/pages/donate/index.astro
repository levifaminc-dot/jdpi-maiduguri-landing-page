---
import {pageEditor} from "../../lib/page-editor";
import {getContent,safeExternalUrl} from '../../lib/content';
import {getDonationGateways} from '../../lib/donations';
import donationConfig from '../../../config/donations.json';
import Layout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/DonationIcon.astro';
import ProgrammeIcon from '../../components/ProjectIcon.astro';
import '../../styles/project-directory.css';
import '../../styles/donations.css';
const content=await getContent();
const page=pageEditor(content,"donate");const {settings}=content;
const gateways=getDonationGateways(donationConfig,import.meta.env,settings.donationUrl);
const initial=gateways.find(gateway=>gateway.oneTimeUrl)||gateways[0];
const pending=!gateways.some(gateway=>gateway.oneTimeUrl||gateway.monthlyUrl);
const otherCheckout=safeExternalUrl(settings.donationUrl);
const separateCheckout=otherCheckout&&!gateways.some(gateway=>gateway.oneTimeUrl===otherCheckout)?otherCheckout:undefined;
const emailFor=(subject:string)=>`mailto:${settings.email}?subject=${encodeURIComponent(subject)}`;
const helpLink=emailFor('Donation enquiry — JDPI Maiduguri');
const areas=[
  {icon:'food' as const,title:'Resilient livelihoods',copy:'Food security, practical skills and opportunities to build a more secure future.',url:'/programmes/food-security-and-livelihoods/'},
  {icon:'water' as const,title:'Healthier communities',copy:'Nutrition, safe water and hygiene support shaped around people’s needs.',url:'/programmes/nutrition/'},
  {icon:'peace' as const,title:'Safety, dignity & peace',copy:'Protection, wellbeing and community dialogue that strengthen peaceful coexistence.',url:'/programmes/peacebuilding-and-social-cohesion/'}
];
---
<Layout content={content} title={`${page.text("seoTitle")} | ${content.settings.shortName}`} description={page.text("seoDescription")} pageClass="projects-page donation-page">
  <section class="dn-hero" aria-labelledby="donate-heading"><div class="project-shell">
    <nav class="dn-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Donate</span></nav>
    <div class="dn-hero-grid">
      <div class="dn-story">
        <img src={page.image("donateImage1").url} alt={page.image("donateImage1").alt} width="802" height="394" fetchpriority="high"/>
        <div class="dn-story-copy"><p class="dn-eyebrow">{page.text("donateParagraph1")}</p><h1 id="donate-heading">{page.text("donateHeading1")}<br/><span>{page.text("donateText1")}</span></h1><p>{page.text("donateParagraph2")}</p><div class="dn-place"><ProgrammeIcon name="location"/><span>{page.text("donateText2")}</span></div></div>
        <p class="dn-photo-credit">{page.text("donateParagraph3")}</p>
      </div>
      <section class="dn-giving" id="give" aria-labelledby="giving-heading" data-donation-panel data-email={settings.email}>
        <div class="dn-panel-heading"><span class="dn-heart"><Icon name="heart"/></span><div><p class="dn-eyebrow">{page.text("givingParagraph1")}</p><h2 id="giving-heading">{page.text("givingHeading1")}</h2></div></div>
        <p class="dn-panel-intro">{page.text("givingParagraph2")}</p>
        {pending&&<p class="dn-setup-note">Online giving is being prepared. You can explore the options below and contact JDPI for an approved way to give today.</p>}
        <div data-donation-enhancement hidden>
          <fieldset class="dn-frequency"><legend>How often would you like to give?</legend><div><label><input type="radio" name="giving-frequency" value="once" checked/><span>Give once</span></label><label><input type="radio" name="giving-frequency" value="monthly"/><span>Monthly</span></label></div></fieldset>
          <fieldset class="dn-gateways"><legend>Choose a payment provider</legend>{gateways.map(gateway=><label class:list={['dn-gateway',`dn-${gateway.id}`]} data-gateway-card data-once-url={gateway.oneTimeUrl} data-monthly-url={gateway.monthlyUrl} data-provider-name={gateway.name}>
            <input type="radio" name="donation-gateway" value={gateway.id} checked={gateway.id===initial.id}/><span class="dn-provider-copy"><span class="dn-provider-name">{gateway.name}</span><span class="dn-provider-state" data-provider-state>{gateway.oneTimeUrl?'Hosted checkout':'Awaiting activation'}</span></span><Icon name="arrow"/>
          </label>)}</fieldset>
        </div>
        <div class="dn-checkout-detail"><p class="dn-selection-note" data-donation-status role="status" aria-live="polite" aria-atomic="true">{initial.oneTimeUrl?`Continue to ${initial.name} to review your gift and payment options.`:`${initial.name}’s one-time donation link is not yet available. Contact JDPI for an approved way to give.`}</p>
          <a class="dn-primary" data-donation-checkout href={initial.oneTimeUrl||helpLink} rel={initial.oneTimeUrl?'noopener noreferrer':undefined}><span data-donation-action>{initial.oneTimeUrl?`Continue with ${initial.name}`:'Ask JDPI about giving'}</span><Icon name="arrow"/></a>
          <p class="dn-checkout-note"><Icon name="lock"/><span>No card or bank details are collected on this website. When activated, payments take place on the selected provider’s checkout.</span></p>
        </div>
        <noscript><div class="dn-nojs"><h3>Available giving links</h3>{gateways.map(gateway=><div><strong>{gateway.name}</strong>{gateway.oneTimeUrl?<a href={gateway.oneTimeUrl} rel="noopener noreferrer">Give once with {gateway.name} →</a>:<p>One-time checkout awaiting activation.</p>}{gateway.monthlyUrl?<a href={gateway.monthlyUrl} rel="noopener noreferrer">Monthly giving with {gateway.name} →</a>:<p>Monthly checkout awaiting activation.</p>}</div>)}</div></noscript>
        {separateCheckout&&<a class="dn-inline-link" href={separateCheckout} rel="noopener noreferrer">{page.text("givingLinkLabel1")}</a>}
        <a class="dn-help-link" href="#other-ways">{page.text("givingLinkLabel2")}</a>
      </section>
    </div>
  </div></section>
  <div class="dn-assurance"><div class="project-shell"><span><Icon name="heart"/>{page.text("introText1")}</span><span><ProgrammeIcon name="location"/>{page.text("introText2")}</span><a href="/resources/"><Icon name="receipt"/>{page.text("introLinkLabel1")}</a></div></div>
  <section class="project-shell dn-purpose" aria-labelledby="purpose-heading">
    <div class="dn-section-heading"><div><p class="dn-eyebrow">{page.text("purposeParagraph1")}</p><h2 id="purpose-heading">{page.text("purposeHeading1")}</h2></div><p>{page.text("purposeParagraph2")}</p></div>
    <div class="dn-area-grid">{areas.map(area=><article><span class="dn-area-icon"><ProgrammeIcon name={area.icon}/></span><h3>{area.title}</h3><p>{area.copy}</p><a href={area.url}>{page.text("purposeLinkLabel1")} <Icon name="arrow"/><span class="sr-only">— {area.title}</span></a></article>)}</div>
    <p class="dn-purpose-note">{page.text("purposeParagraph3")}</p>
  </section>
  <section class="dn-evidence" aria-labelledby="evidence-heading"><div class="project-shell dn-evidence-grid"><div class="dn-evidence-photo"><img src={page.image("evidenceImage1").url} alt={page.image("evidenceImage1").alt} width="1200" height="656" loading="lazy"/><span>{page.text("evidenceText1")}</span></div><div><p class="dn-eyebrow">{page.text("evidenceParagraph1")}</p><h2 id="evidence-heading">{page.text("evidenceHeading1")}<br/><span>{page.text("evidenceText2")}</span></h2><p>{page.text("evidenceParagraph2")}</p><div class="dn-evidence-links"><a class="dn-primary" href="/impact/">{page.text("evidenceLinkLabel1")} <Icon name="arrow"/></a><a class="dn-inline-link" href="/resources/">{page.text("evidenceLinkLabel2")}</a></div><p class="dn-evidence-note">{page.text("evidenceParagraph3")}</p></div></div></section>
  <section class="project-shell dn-other" id="other-ways" aria-labelledby="other-heading"><div class="dn-section-heading"><div><p class="dn-eyebrow">{page.text("otherParagraph1")}</p><h2 id="other-heading">{page.text("otherHeading1")}</h2></div><a class="dn-inline-link" href="/contact/">{page.text("otherLinkLabel1")}</a></div><div class="dn-other-grid">
    <article><span class="dn-area-icon"><Icon name="bank"/></span><h3>{page.text("otherHeading2")}</h3><p>{page.text("otherParagraph2")}</p><a href={emailFor('Donation enquiry — verified bank transfer details')}>{page.text("otherLinkLabel2")} <Icon name="arrow"/></a></article>
    <article><span class="dn-area-icon"><Icon name="heart"/></span><h3>{page.text("otherHeading3")}</h3><p>{page.text("otherParagraph3")}</p><a href={emailFor('Donation enquiry — partnership or larger gift')}>{page.text("otherLinkLabel3")} <Icon name="arrow"/></a></article>
    <article><span class="dn-area-icon"><Icon name="gift"/></span><h3>{page.text("otherHeading4")}</h3><p>{page.text("otherParagraph4")}</p><a href={emailFor('Donation enquiry — in-kind support')}>{page.text("otherLinkLabel4")} <Icon name="arrow"/></a></article>
  </div></section>
  <section class="project-shell dn-faq" aria-labelledby="faq-heading"><div><p class="dn-eyebrow">{page.text("faqParagraph1")}</p><h2 id="faq-heading">{page.text("faqHeading1")}</h2><p>{page.text("faqParagraph2")}</p><a class="dn-inline-link" href={helpLink}>{page.text("faqLinkLabel1")}</a></div><div class="dn-questions">
    <details><summary>Can I donate online right now?</summary><p>Only options labelled “Hosted checkout” lead to an approved JDPI payment page. Options awaiting activation do not take payments; contact our team for an approved way to give.</p></details>
    <details><summary>Which amounts, currencies and payment methods can I use?</summary><p>Your final amount, currency and available payment methods are shown on the provider’s checkout. They depend on JDPI’s account and checkout configuration. Review them before authorising payment.</p></details>
    <details><summary>How does monthly giving work?</summary><p>Monthly giving becomes available only when JDPI supplies an approved recurring-payment link. Choosing “Monthly” on this page does not create a subscription or charge you. Review the schedule and cancellation information on the provider’s checkout before authorising it.</p></details>
    <details><summary>Can I support a particular project?</summary><p>Please contact JDPI first to confirm whether a restricted gift can be accepted. Selecting a payment provider does not earmark your donation for a project.</p></details>
    <details><summary>What about receipts, refunds or tax relief?</summary><p>Keep the transaction confirmation provided at checkout. For a JDPI acknowledgement, a payment problem or a refund enquiry, contact our team with your transaction reference—not your card details. Tax treatment depends on your circumstances and jurisdiction; this page does not promise tax deductibility.</p></details>
  </div></section>
  <script>import '../../scripts/donation-options';</script>
</Layout>
