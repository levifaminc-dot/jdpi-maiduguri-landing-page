---
import {pageEditor} from "../../lib/page-editor";
import {getContent} from '../../lib/content';
import {getImpact} from '../../lib/impact';
import {getProjectProfile} from '../../lib/project-profiles';
import {getPublishedResources} from '../../lib/resources';
import Layout from '../../layouts/SiteLayout.astro';
import ContentImage from '../../components/ContentImage.astro';
import ImpactProgrammeTabs from '../../components/ImpactProgrammeTabs.astro';
import ImpactCoverageMaps from '../../components/ImpactCoverageMaps.astro';
import '../../styles/project-directory.css';
import '../../styles/contact-impact.css';
import '../../styles/impact-storytelling.css';
import '../../styles/impact-interactions.css';

const content = await getContent();
const page=pageEditor(content,"impact");
const {impactYear,impactOverview,sectorImpact}=getImpact(content);
const report = getPublishedResources(content).find(item => item.title === 'JDPI Annual Report 2025');
const bmz = content.projects.find(project => project.slug === 'bmz-multisectoral-resilience-project');
const weSing = content.projects.find(project => project.slug === 'we-sing-project');
const weSingStory = weSing ? getProjectProfile(weSing).stories[0] : undefined;
const bmzStory = bmz ? getProjectProfile(bmz).stories[0] : undefined;
const image = (name:string, alt:string) => page.data<{name:string;image:import('../../lib/content').ContentImage}[]>('photos',[]).find(photo=>photo.name===name)?.image || ({url:`/assets/projects/${name}.jpg`,alt});
---
<Layout content={content} title={`${page.text("seoTitle")} | ${content.settings.shortName}`} description={page.text("seoDescription")} pageClass="projects-page impact-page impact-editorial">
  <section class="ie-hero" aria-labelledby="impact-heading">
    <div class="ie-hero-copy">
      <nav class="ci-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Our Impact</span></nav>
      <p class="ie-eyebrow">{page.text("impactParagraph1")} {impactYear} {page.text("impactParagraph2")}</p>
      <h1 id="impact-heading">{page.text("impactHeading1")}<br/><span>{page.text("impactText1")}<br class="ie-title-break"/> {page.text("impactText2")}</span></h1>
      <p class="ie-hero-lead">{page.text("impactParagraph3")}</p>
      <p class="ie-hero-intro">{page.text("impactParagraph4")}</p>
      <a class="ie-button" href="#stories-heading">{page.text("impactLinkLabel1")}</a>
    </div>
    <figure class="ie-hero-photo">
      <ContentImage image={image('bmz-greenhouse-monitoring','A farmer and JDPI staff checking crops in a community greenhouse')} eager/>
      <figcaption><span>{page.text("impactText3")}</span> {page.text("impactCaption1")}</figcaption>
    </figure>
  </section>

  <nav class="ie-section-nav" aria-label="Explore our impact"><div class="project-shell"><a href="#stories-heading">Community stories</a><a href="#sectors-heading">Our results</a><a href="#coverage-heading">Where we work</a><a href="#accountability-heading">The evidence</a><span>{impactYear} Annual Report</span></div></nav>

  <section class="ie-overview" aria-labelledby="overview-heading">
    <div class="project-shell">
      <div class="ie-overview-head"><h2 id="overview-heading">{page.text("overviewHeading1")}<br/>{page.text("overviewHeading2")}</h2><p>{page.text("overviewParagraph1")} {impactYear}<br/>{page.text("overviewParagraph2")}</p></div>
      <dl class="impact-stat-strip">{impactOverview.map(fact => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>
    </div>
  </section>

  <section class="ie-stories project-shell" aria-labelledby="stories-heading">
    <header class="ie-section-heading"><div><p class="ie-eyebrow">{page.text("storiesParagraph1")}</p><h2 id="stories-heading">{page.text("storiesHeading1")}</h2></div><p>{page.text("storiesParagraph2")}<br/>{' '}{page.text("storiesParagraph3")} {impactYear} {page.text("storiesParagraph4")}</p></header>

    <article class="ie-story ie-growing" aria-labelledby="growing-heading">
      <div class="ie-story-visual">
        <figure class="ie-main-image"><ContentImage image={image('bmz-greenhouse-crops','Vegetable crops growing in a JDPI-supported community greenhouse')}/><figcaption>{page.text("growingCaption1")}</figcaption></figure>
        <figure class="ie-inset-image"><ContentImage image={image('bmz-greenhouse-harvest','Peppers harvested from a community greenhouse')}/><figcaption>{page.text("growingCaption2")}</figcaption></figure>
      </div>
      <div class="ie-story-copy"><p class="ie-eyebrow">{page.text("growingParagraph1")}</p><h3 id="growing-heading">{page.text("growingHeading1")}<br/><span>{page.text("growingText1")}</span></h3><p>{page.text("growingParagraph2")}</p><p>{page.text("growingParagraph3")}</p><dl class="ie-story-facts"><div><dt>{page.text("growingText2")}</dt><dd>{page.text("growingText3")}</dd></div><div><dt>{page.text("growingText4")}</dt><dd>{page.text("growingText5")}</dd></div></dl><p class="ie-source">{page.text("growingParagraph4")} {impactYear}{page.text("growingParagraph5")}</p>{bmz && <a class="ie-link" href={`/projects/${bmz.slug}/`}>{page.text("growingLinkLabel1")}</a>}</div>
    </article>

    <article class="ie-story ie-women" aria-labelledby="women-heading">
      <figure class="ie-women-image"><ContentImage image={image('we-sing-startup-kits','A participant receiving a sewing-machine livelihood kit at the WE-SING distribution')}/><figcaption>{page.text("womenCaption1")}</figcaption></figure>
      <div class="ie-story-copy"><p class="ie-eyebrow">{page.text("womenParagraph1")}</p><h3 id="women-heading">{page.text("womenHeading1")}<br/><span>{page.text("womenText1")}<br/>{page.text("womenText2")}</span></h3><p>{page.text("womenParagraph2")}</p><p>{weSingStory?.text || 'The report describes women starting new businesses or expanding existing enterprises after receiving support tailored to their skills, interests and livelihood aspirations.'}</p><div class="ie-story-highlight"><strong>{page.text("womenText3")}</strong><span>{page.text("womenText4")}<br/>{page.text("womenText5")}</span></div><p class="ie-source">{page.text("womenParagraph3")} {impactYear}{page.text("womenParagraph4")}</p>{weSing && <a class="ie-link" href={`/projects/${weSing.slug}/`}>{page.text("womenLinkLabel1")}</a>}</div>
    </article>
    {bmzStory && <article class="ie-personal-story" aria-labelledby="enterprise-heading">
      <div><p class="ie-eyebrow">{page.text("enterpriseParagraph1")}</p><h3 id="enterprise-heading">{page.text("enterpriseHeading1")}<br/>{page.text("enterpriseHeading2")}</h3><p class="ie-source">{bmzStory.source}</p></div>
      <div><p>{bmzStory.text}</p><dl class="ie-enterprise-progress"><div><dt>{page.text("enterpriseText1")}</dt><dd>2</dd></div><span aria-hidden="true">→</span><div><dt>{page.text("enterpriseText2")}</dt><dd><span>{page.text("enterpriseText3")} </span>{page.text("enterpriseText4")}</dd></div></dl><p class="ie-case-note">{page.text("enterpriseParagraph2")}</p></div>
    </article>}
    <div class="ie-story-end"><p>{page.text("storiesParagraph5")}</p><a class="ie-link" href="/projects/">{page.text("storiesLinkLabel1")}</a></div>
  </section>

  <section class="ie-results" aria-labelledby="sectors-heading"><div class="project-shell">
    <header class="ie-section-heading"><div><p class="ie-eyebrow">{page.text("sectorsParagraph1")} {impactYear} {page.text("sectorsParagraph2")}</p><h2 id="sectors-heading">{page.text("sectorsHeading1")}<br/>{page.text("sectorsHeading2")}</h2></div><p>{page.text("sectorsParagraph3")}<br/>{' '}{page.text("sectorsParagraph4")}</p></header>
    <ImpactProgrammeTabs sectorImpact={sectorImpact} impactYear={impactYear}/>
    <p class="impact-count-note"><strong>{page.text("sectorsText1")}</strong> {page.text("sectorsParagraph5")}</p>
  </div></section>

  <section class="ie-coverage project-shell" aria-labelledby="coverage-heading">
    <header class="ie-section-heading"><div><p class="ie-eyebrow">{page.text("coverageParagraph1")}</p><h2 id="coverage-heading">{page.text("coverageHeading1")}</h2></div><p>{page.text("coverageParagraph2")}<br/>{' '}{page.text("coverageParagraph3")} {impactYear}</p></header>
    <ImpactCoverageMaps lgaActivities={pageEditor(content,'where-we-work').data('lgaActivities',undefined)} impactYear={impactYear}/>
    <a class="ie-link" href="/where-we-work/">{page.text("coverageLinkLabel1")}</a>
  </section>

  <section class="ie-accountability" aria-labelledby="accountability-heading"><div class="project-shell ie-report-grid">
    <div><p class="ie-eyebrow">{page.text("accountabilityParagraph1")}</p><h2 id="accountability-heading">{page.text("accountabilityHeading1")}<br/><span>{page.text("accountabilityText1")}</span></h2><p>{page.text("accountabilityParagraph2")} {impactYear} {page.text("accountabilityParagraph3")}</p><div class="ie-report-actions">{report && <a class="ie-button" href={report.fileUrl} target="_blank" rel="noopener noreferrer">{page.text("accountabilityLinkLabel1")} <span class="sr-only">(opens in a new tab)</span></a>}<a class="ie-link" href="/resources/">{page.text("accountabilityLinkLabel2")}</a></div></div>
    <aside class="ie-report-note"><span class="ie-report-year">{impactYear}</span><p>{page.text("accountabilityParagraph4")}<br/>{page.text("accountabilityParagraph5")}</p><div><h3>{page.text("accountabilityHeading2")}</h3><p>{page.text("accountabilityParagraph6")}</p><a class="ie-link" href="/contact/">{page.text("accountabilityLinkLabel3")}</a></div></aside>
  </div></section>
<script>import '../../scripts/impact-interactions';</script>
</Layout>
