---
import {getContent} from '../../lib/content';
import {impactYear,impactOverview,sectorImpact,impactCoverage} from '../../lib/impact';
import {getProjectProfile} from '../../lib/project-profiles';
import {getResourceLibrary} from '../../lib/resources';
import Layout from '../../layouts/SiteLayout.astro';
import ContentImage from '../../components/ContentImage.astro';
import '../../styles/project-directory.css';
import '../../styles/contact-impact.css';
const content=await getContent();
const report=getResourceLibrary(content.reports).find(item=>item.title==='JDPI Annual Report 2025');
const stories=['bmz-multisectoral-resilience-project','we-sing-project'].map(slug=>content.projects.find(project=>project.slug===slug)).filter((project):project is NonNullable<typeof project>=>Boolean(project)).map(project=>({project,profile:getProjectProfile(project)}));
const heroImage={url:'/assets/projects/bmz-greenhouse-monitoring.jpg',alt:'A farmer and JDPI staff checking crops in a community greenhouse'};
---
<Layout content={content} title={`Our Impact | ${content.settings.shortName}`} description="Explore JDPI Maiduguri’s reported 2025 results across livelihoods, nutrition, safe water, protection, psychosocial support and peacebuilding." pageClass="projects-page impact-page">
  <section class="project-hero impact-hero" aria-labelledby="impact-heading"><ContentImage image={heroImage} class="project-hero-image" eager/><div class="project-shell project-hero-content"><nav class="project-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Our Impact</span></nav><p class="project-eyebrow">OUR IMPACT · {impactYear} REPORT</p><h1 id="impact-heading">Real people.<br/><span>Lasting change.</span></h1><p class="project-hero-intro">Supporting communities to meet urgent needs, rebuild livelihoods and strengthen peace across Northeast Nigeria.</p><p class="impact-hero-caption">Community greenhouse monitoring · Annual Report 2025, page 17</p></div></section>
  <div class="project-shell impact-content">
    <section class="ci-section impact-overview" aria-labelledby="overview-heading"><div class="ci-section-head"><h2 id="overview-heading">{impactYear} at a glance</h2><p>January–December {impactYear} · Annual Report, pages 10–12</p></div><dl class="impact-stat-strip">{impactOverview.map(fact=><div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl></section>
    <section class="ci-section" aria-labelledby="sectors-heading"><div class="ci-section-head"><h2 id="sectors-heading">Impact across our programmes</h2><p>Results reported for {impactYear}</p></div><p class="impact-count-note">Programme counts measure different services and may include people reached by more than one intervention. They are not added together as a unique-person total.</p><div class="impact-sector-grid">{sectorImpact.map(sector=><article><h3>{sector.title}</h3><dl><dt>{sector.label}</dt><dd>{sector.estimated && <span class="impact-estimate">Estimated </span>}{sector.value}</dd></dl><p>{sector.description}</p><div class="impact-sector-source"><span>Report, {sector.source.toLowerCase()}</span><a class="ci-text-link" href={`/programmes/${sector.slug}/`}>Explore programme <span class="sr-only">— {sector.title}</span></a></div></article>)}</div></section>
    <section class="ci-section impact-coverage" aria-labelledby="coverage-heading"><div class="ci-section-head"><h2 id="coverage-heading">Rooted in Northeast Nigeria</h2><p>3 states · 20 local government areas · 114 communities</p></div><p>JDPI’s {impactYear} report records work across Borno, Adamawa and Yobe. These are the local government areas listed in the report.</p><div class="impact-state-grid">{impactCoverage.map(region=><article><h3>{region.state} State</h3><ul>{region.areas.map(area=><li>{area}</li>)}</ul></article>)}</div><p class="impact-source-note">Geographical coverage · Annual Report {impactYear}, page 12</p></section>
    <section class="ci-section" aria-labelledby="stories-heading"><div class="ci-section-head"><h2 id="stories-heading">Behind the numbers</h2><a class="ci-text-link" href="/projects/">View our projects</a></div><div class="impact-story-grid">{stories.map(({project,profile})=><article><ContentImage image={project.image}/><div><p class="ci-eyebrow">{project.title}</p><h3>{project.slug==='bmz-multisectoral-resilience-project'?'Growing resilience, season after season':'Tools for women’s own ambitions'}</h3><p>{project.slug==='bmz-multisectoral-resilience-project'?'Twenty community greenhouses supported 263 households in Hong and Michika with climate-smart vegetable production. The project connected practical agricultural support with nutrition, livelihoods and community resilience.':profile.stories[0]?.text}</p><p class="impact-source-note">Annual Report {impactYear}, {project.slug==='bmz-multisectoral-resilience-project'?'pages 17–18':'page 16'}</p><a class="ci-text-link" href={`/projects/${project.slug}/`}>Explore project <span class="sr-only">— {project.title}</span></a></div></article>)}</div></section>
    <section class="impact-accountability" aria-labelledby="accountability-heading"><div><p class="ci-eyebrow">EVIDENCE &amp; ACCOUNTABILITY</p><h2 id="accountability-heading">See the work behind the results.</h2><p>These highlights come from JDPI’s {impactYear} annual report. Explore the full report for programme context, community stories and financial reporting.</p></div><div class="impact-report-actions">{report && <a class="ci-primary" href={report.fileUrl} target="_blank" rel="noopener noreferrer">Open 2025 annual report <span class="sr-only">(opens in a new tab)</span></a>}<a class="ci-text-link" href="/resources/">Reports &amp; resources</a><a class="ci-text-link" href="/contact/">Contact our team</a></div></section>
  </div>
</Layout>
