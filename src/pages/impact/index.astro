---
import {getContent} from '../../lib/content';
import {impactYear, impactOverview} from '../../lib/impact';
import {getProjectProfile} from '../../lib/project-profiles';
import {getResourceLibrary} from '../../lib/resources';
import Layout from '../../layouts/SiteLayout.astro';
import ContentImage from '../../components/ContentImage.astro';
import ImpactProgrammeTabs from '../../components/ImpactProgrammeTabs.astro';
import ImpactCoverageMaps from '../../components/ImpactCoverageMaps.astro';
import '../../styles/project-directory.css';
import '../../styles/contact-impact.css';
import '../../styles/impact-storytelling.css';
import '../../styles/impact-interactions.css';

const content = await getContent();
const report = getResourceLibrary(content.reports).find(item => item.title === 'JDPI Annual Report 2025');
const bmz = content.projects.find(project => project.slug === 'bmz-multisectoral-resilience-project');
const weSing = content.projects.find(project => project.slug === 'we-sing-project');
const weSingStory = weSing ? getProjectProfile(weSing).stories[0] : undefined;
const bmzStory = bmz ? getProjectProfile(bmz).stories[0] : undefined;
const image = (name:string, alt:string) => ({url:`/assets/projects/${name}.jpg`, alt});
---
<Layout content={content} title={`Our Impact | ${content.settings.shortName}`} description="The people, communities and stories behind JDPI Maiduguri’s 2025 results. Explore livelihoods, safe water, wellbeing and peace across Northeast Nigeria." pageClass="projects-page impact-page impact-editorial">
  <section class="ie-hero" aria-labelledby="impact-heading">
    <div class="ie-hero-copy">
      <nav class="ci-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Our Impact</span></nav>
      <p class="ie-eyebrow">OUR IMPACT · {impactYear} IN FOCUS</p>
      <h1 id="impact-heading">Real people.<br/><span>Lasting<br class="ie-title-break"/> change.</span></h1>
      <p class="ie-hero-lead">A livelihood rebuilt. A community strengthened. A new possibility for tomorrow.</p>
      <p class="ie-hero-intro">Behind every result are people shaping their own futures. Discover how JDPI supports that journey across Northeast Nigeria.</p>
      <a class="ie-button" href="#stories-heading">Discover the stories</a>
    </div>
    <figure class="ie-hero-photo">
      <ContentImage image={image('bmz-greenhouse-monitoring','A farmer and JDPI staff checking crops in a community greenhouse')} eager/>
      <figcaption><span>Growing resilience, together.</span> Community greenhouse monitoring · Report, page 17</figcaption>
    </figure>
  </section>

  <nav class="ie-section-nav" aria-label="Explore our impact"><div class="project-shell"><a href="#stories-heading">Community stories</a><a href="#sectors-heading">Our results</a><a href="#coverage-heading">Where we work</a><a href="#accountability-heading">The evidence</a><span>{impactYear} Annual Report</span></div></nav>

  <section class="ie-overview" aria-labelledby="overview-heading">
    <div class="project-shell">
      <div class="ie-overview-head"><h2 id="overview-heading">A year of working<br/>alongside communities.</h2><p>January–December {impactYear}<br/>Reported results · Annual Report, pages 10–12</p></div>
      <dl class="impact-stat-strip">{impactOverview.map(fact => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>
    </div>
  </section>

  <section class="ie-stories project-shell" aria-labelledby="stories-heading">
    <header class="ie-section-heading"><div><p class="ie-eyebrow">BEHIND THE NUMBERS</p><h2 id="stories-heading">This is what change looks like.</h2></div><p>Practical support. Community ambition.<br/>{' '}Stories from our {impactYear} annual report.</p></header>

    <article class="ie-story ie-growing" aria-labelledby="growing-heading">
      <div class="ie-story-visual">
        <figure class="ie-main-image"><ContentImage image={image('bmz-greenhouse-crops','Vegetable crops growing in a JDPI-supported community greenhouse')}/><figcaption>Community greenhouse crops · Annual Report, page 18</figcaption></figure>
        <figure class="ie-inset-image"><ContentImage image={image('bmz-greenhouse-harvest','Peppers harvested from a community greenhouse')}/><figcaption>A greenhouse harvest · Report, page 17</figcaption></figure>
      </div>
      <div class="ie-story-copy"><p class="ie-eyebrow">LIVELIHOODS · HONG &amp; MICHIKA</p><h3 id="growing-heading">More than a harvest.<br/><span>A way forward.</span></h3><p>For families in Hong and Michika, community greenhouses created opportunities to grow vegetables throughout the year. Climate-smart agricultural support connected food production with nutrition and livelihoods.</p><p>The BMZ Multisectoral Resilience Project supported 263 households through 20 community greenhouses—building resilience, season after season.</p><dl class="ie-story-facts"><div><dt>Households supported</dt><dd>263</dd></div><div><dt>Community greenhouses</dt><dd>20</dd></div></dl><p class="ie-source">Annual Report {impactYear}, pages 17–18</p>{bmz && <a class="ie-link" href={`/projects/${bmz.slug}/`}>Explore the BMZ project</a>}</div>
    </article>

    <article class="ie-story ie-women" aria-labelledby="women-heading">
      <figure class="ie-women-image"><ContentImage image={image('we-sing-startup-kits','A participant receiving a sewing-machine livelihood kit at the WE-SING distribution')}/><figcaption>WE-SING livelihood kit distribution · Annual Report, page 16</figcaption></figure>
      <div class="ie-story-copy"><p class="ie-eyebrow">WOMEN’S LIVELIHOODS · BORNO</p><h3 id="women-heading">Her skills.<br/><span>Her ambitions.<br/>Her next chapter.</span></h3><p>One hundred women received start-up kits aligned with their chosen trades, including tailoring, petty trading and food processing.</p><p>{weSingStory?.text || 'The report describes women starting new businesses or expanding existing enterprises after receiving support tailored to their skills, interests and livelihood aspirations.'}</p><div class="ie-story-highlight"><strong>100</strong><span>women received trade-specific<br/>livelihood start-up kits</span></div><p class="ie-source">Annual Report {impactYear}, page 16</p>{weSing && <a class="ie-link" href={`/projects/${weSing.slug}/`}>Explore the WE-SING project</a>}</div>
    </article>
    {bmzStory && <article class="ie-personal-story" aria-labelledby="enterprise-heading">
      <div><p class="ie-eyebrow">A LIVELIHOOD STORY · MICHIKA</p><h3 id="enterprise-heading">A small start.<br/>A growing livelihood.</h3><p class="ie-source">{bmzStory.source}</p></div>
      <div><p>{bmzStory.text}</p><dl class="ie-enterprise-progress"><div><dt>Bags bought at the start</dt><dd>2</dd></div><span aria-hidden="true">→</span><div><dt>Bags bought at a time as the business grew</dt><dd><span>Up to </span>20</dd></div></dl><p class="ie-case-note">One participant’s experience, as described in the report—not an organisation-wide result.</p></div>
    </article>}
    <div class="ie-story-end"><p>Every project is part of a bigger story.</p><a class="ie-link" href="/projects/">Explore all our projects</a></div>
  </section>

  <section class="ie-results" aria-labelledby="sectors-heading"><div class="project-shell">
    <header class="ie-section-heading"><div><p class="ie-eyebrow">OUR {impactYear} RESULTS</p><h2 id="sectors-heading">Different needs.<br/>One commitment to dignity.</h2></div><p>From essential services to stronger livelihoods,<br/>{' '}our programmes respond to the whole community.</p></header>
    <ImpactProgrammeTabs/>
    <p class="impact-count-note"><strong>A note on these figures.</strong> Programme counts measure different services and may include people reached by more than one intervention. They are not added together as a unique-person total.</p>
  </div></section>

  <section class="ie-coverage project-shell" aria-labelledby="coverage-heading">
    <header class="ie-section-heading"><div><p class="ie-eyebrow">CLOSE TO THE COMMUNITIES WE SERVE</p><h2 id="coverage-heading">Rooted in Northeast Nigeria.</h2></div><p>3 states · 20 local government areas<br/>{' '}114 communities in {impactYear}</p></header>
    <ImpactCoverageMaps/>
  </section>

  <section class="ie-accountability" aria-labelledby="accountability-heading"><div class="project-shell ie-report-grid">
    <div><p class="ie-eyebrow">THE WORK. THE STORIES. THE EVIDENCE.</p><h2 id="accountability-heading">Impact you can<br/><span>look into.</span></h2><p>These highlights are only part of the picture. Our {impactYear} annual report brings together programme results, community stories and financial reporting.</p><div class="ie-report-actions">{report && <a class="ie-button" href={report.fileUrl} target="_blank" rel="noopener noreferrer">Read the 2025 annual report <span class="sr-only">(opens in a new tab)</span></a>}<a class="ie-link" href="/resources/">All reports &amp; resources</a></div></div>
    <aside class="ie-report-note"><span class="ie-report-year">{impactYear}</span><p>JDPI MAIDUGURI<br/>ANNUAL REPORT</p><div><h3>Let’s build what comes next.</h3><p>Talk with our team about supporting community-led change.</p><a class="ie-link" href="/contact/">Contact our team</a></div></aside>
  </div></section>
<script>import '../../scripts/impact-interactions';</script>
</Layout>
