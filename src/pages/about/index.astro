---
import {getContent} from '../../lib/content';
import {getResourceLibrary} from '../../lib/resources';
import {timeline,values,approach,leadership} from '../../data/about';
import map from '../../data/about-map.json';
import Layout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/ProjectIcon.astro';
import '../../styles/project-directory.css';
import '../../styles/about.css';
const content=await getContent();
const report=getResourceLibrary(content.reports).find(item=>item.title==='JDPI Annual Report 2025');
const reportPage=(page:number)=>`${report?.fileUrl || '/resources/'}#page=${page}`;
const sectionLinks=[
  ['Who We Are','who-heading'],['Our Story','story-heading'],['Mission & Values','guides-heading'],
  ['Our Identity','identity-heading'],['Where We Work','where-heading'],['Our Approach','approach-heading'],
  ['Leadership','leadership-heading'],['Accountability','accountability-heading'],
  ['Partnerships','partnership-heading'],['Our Work','cta-heading'],
];
const accountability=[
  {title:'Safeguarding',text:'Protecting dignity, safety and wellbeing.',url:reportPage(59)},
  {title:'Community accountability',text:'Listening, learning and responding.',url:reportPage(58)},
  {title:'Feedback & enquiries',text:'Get in touch with our team.',url:'/contact/'},
  {title:'Financial transparency',text:'Explore our published reports.',url:'/resources/'},
];
---
<Layout content={content} title={`About Us | ${content.settings.shortName}`} description="Meet JDPI Maiduguri: our story since 1971, our mission, values and people, and our commitment to human dignity across Northeast Nigeria." pageClass="projects-page about-page">
  <section class="ab-hero" aria-labelledby="about-heading">
    <img class="ab-hero-image" src="/assets/about/peace-conference.jpg" alt="Community members and partners gathered at JDPI’s 2025 peace conference" width="796" height="358" fetchpriority="high"/>
    <div class="ab-shell ab-hero-copy"><p class="ab-kicker">ABOUT JDPI</p><h1 id="about-heading">Rooted in service.<br/><span>Committed to<br class="ab-mobile-break"/> human dignity.</span></h1><p>Working alongside communities across Northeast Nigeria to strengthen resilience, promote peace and create a more dignified future.</p><nav class="ab-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">About Us</span></nav></div>
  </section>

  <nav class="ab-section-nav" aria-label="About page sections"><div class="ab-shell">{sectionLinks.map(([label,id],index)=><a href={`#${id}`} aria-current={index===0?'location':undefined}>{label}</a>)}</div></nav>

  <section class="ab-section ab-shell ab-who" aria-labelledby="who-heading"><div><p class="ab-kicker">WHO WE ARE</p><h2 id="who-heading">Local roots.<br/>A shared purpose.</h2><p>Justice Development and Peace Initiative in Maiduguri Diocese (JDPI Maiduguri) is the faith-based, non-profit humanitarian and development organisation of the Catholic Diocese of Maiduguri.</p><p>Across Borno, Adamawa and Yobe, we work with people affected by conflict, displacement and poverty—meeting immediate needs while supporting recovery, resilience and peaceful coexistence.</p><p>We accompany communities, working with local structures, government institutions, civil society and development partners to address both urgent needs and the causes of vulnerability.</p><strong class="ab-promise">Upholding the dignity of every human person.</strong></div><figure class="ab-who-photo"><img src="/assets/about/community-dialogue.jpg" alt="Community members participating in an outdoor dialogue session under a tree" width="395" height="216" loading="lazy"/><figcaption>Community dialogue · JDPI Annual Report 2025</figcaption><div class="ab-photo-note"><strong>Since 1971</strong><span>A commitment to service.</span></div></figure></section>

  <section class="ab-story ab-section" aria-labelledby="story-heading"><div class="ab-shell"><p class="ab-kicker">OUR STORY</p><h2 id="story-heading">A legacy of service.<br class="ab-mobile-break"/> A continuing journey.</h2><p class="ab-section-intro">Our journey is rooted in the Church’s commitment to justice, peace and the service of people experiencing poverty, conflict and marginalisation.</p><ol class="ab-timeline">{timeline.map(item=><li><span class="ab-timeline-dot" aria-hidden="true"></span><strong>{item.year}</strong><h3>{item.title}</h3><p>{item.text}</p></li>)}</ol></div></section>

  <section class="ab-section ab-shell" aria-labelledby="guides-heading"><p class="ab-kicker">WHAT GUIDES US</p><h2 id="guides-heading">One purpose.<br class="ab-mobile-break"/> Every person matters.</h2><div class="ab-purpose-grid"><article class="ab-mission"><span class="ab-purpose-icon"><Icon name="protection"/></span><div><h3>Our mission</h3><p>To deliver life-saving, life-sustaining and life-building interventions to the most vulnerable.</p></div></article><article class="ab-vision"><span class="ab-purpose-icon"><Icon name="peace"/></span><div><h3>Our vision</h3><p>A just and peaceful society where every person lives with dignity.</p></div></article></div><h3 class="ab-values-heading">Our values</h3><div class="ab-values">{values.map(value=><article><h4>{value.title}</h4><p>{value.text}</p></article>)}</div></section>

  <section class="ab-identity" aria-labelledby="identity-heading"><div class="ab-shell ab-identity-grid"><div><p class="ab-kicker">OUR IDENTITY</p><h2 id="identity-heading">Faith expressed<br/>through service.</h2><p>As the social development arm of the Catholic Diocese of Maiduguri, our work is inspired by Catholic Social Teaching and the inherent dignity of every human person.</p><p>This calls us to stand with people experiencing vulnerability, promote justice and peace, and serve communities with compassion.</p><div class="ab-identity-seal"><span aria-hidden="true">✝</span><span>{content.settings.diocese}<small>Justice · Development · Peace</small></span></div></div><figure><img src="/assets/about/maiduguri-team.jpg" alt="JDPI staff at the headquarters in Maiduguri" width="951" height="455" loading="lazy"/><figcaption>JDPI’s Maiduguri team · Annual Report 2025</figcaption></figure></div></section>

  <section class="ab-section ab-shell" aria-labelledby="where-heading"><p class="ab-kicker">WHERE WE WORK</p><h2 id="where-heading">Rooted in the Northeast.</h2><p class="ab-section-intro">Our programmes work alongside communities across Borno, Adamawa and Yobe—the BAY states.</p><div class="ab-coverage-grid"><figure class="ab-map"><svg viewBox="0 0 440 410" role="img" aria-labelledby="ab-map-title ab-map-description"><title id="ab-map-title">JDPI’s three states of operation</title><desc id="ab-map-description">Geographically aligned boundaries of Yobe, Borno and Adamawa in Northeast Nigeria. State coverage, not individual project sites.</desc>{map.states.map(state=><g><path d={state.path} class={`ab-state ab-state-${state.name.toLowerCase()}`} fill-rule="evenodd"/><text x={state.label[0]} y={state.label[1]} text-anchor="middle">{state.name}</text></g>)}</svg><figcaption>State boundaries: GRID3 via geoBoundaries, 2022 · <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a></figcaption></figure><div class="ab-offices"><h3>Our offices</h3><ul>{[['Maiduguri','Headquarters · Borno'],['Mubi','Office base · Adamawa'],['Potiskum','Office base · Yobe']].map(([name,detail])=><li><Icon name="location"/><div><strong>{name}</strong><span>{detail}</span></div></li>)}</ul><a class="ab-text-link" href="/contact/#office-heading">Visit or contact us <Icon name="arrow"/></a></div><div class="ab-coverage-copy"><p>We implement humanitarian and development programmes with local structures, community groups and partners—connecting essential support with longer-term opportunities.</p><p>Explore our Impact page for the local government areas listed in our 2025 report.</p><a class="ab-button" href="/impact/#coverage-heading">Explore our coverage <Icon name="arrow"/></a></div></div></section>

  <section class="ab-approach ab-section" aria-labelledby="approach-heading"><div class="ab-shell"><p class="ab-kicker">OUR APPROACH</p><h2 id="approach-heading">Working with communities,<br/>not simply for them.</h2><div class="ab-approach-grid">{approach.map((item,index)=><article><span class="ab-approach-number" aria-hidden="true">0{index+1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>

  <section class="ab-section ab-shell" aria-labelledby="leadership-heading"><header class="ab-heading-row"><div><p class="ab-kicker">OUR PEOPLE</p><h2 id="leadership-heading">Leadership in service.</h2><p class="ab-section-intro">Our Board of Trustees and management team guide our programmes, people and organisational systems.</p></div><span class="ab-year-note">As listed in our<br/><strong>2025 Annual Report</strong></span></header><div class="ab-leadership-grid">{leadership.map(person=><article class="ab-person"><img src={`/assets/about/${person.image}.jpg`} alt={person.name} width="250" height="250" loading="lazy"/><div><h3>{person.name}</h3><p>{person.role}</p><span>{person.detail}</span></div></article>)}<aside class="ab-team-card"><img src="/assets/projects/allright-stakeholder-workshop.jpg" alt="JDPI colleagues collaborating at an ALLRight stakeholder workshop" width="762" height="408" loading="lazy"/><div><h3>A dedicated team.<br/>A shared commitment.</h3><p>Behind every programme are people bringing local knowledge, skills and care to the communities we serve.</p><a class="ab-text-link" href={reportPage(64)} target="_blank" rel="noopener noreferrer">Meet our team <Icon name="arrow"/><span class="ab-sr-only"> in the 2025 annual report (opens in a new tab)</span></a></div></aside></div></section>

  <section class="ab-accountability ab-section" aria-labelledby="accountability-heading"><div class="ab-shell"><p class="ab-kicker">RESPONSIBILITY &amp; TRUST</p><h2 id="accountability-heading">Our commitment to accountability.</h2><p class="ab-section-intro">Responsible, transparent programming protects the dignity, rights and safety of the people and communities we work with.</p><div class="ab-accountability-links">{accountability.map(item=><a href={item.url} target={item.url.startsWith('https:')?'_blank':undefined} rel={item.url.startsWith('https:')?'noopener noreferrer':undefined}><div><h3>{item.title}</h3><p>{item.text}</p></div><Icon name="arrow"/>{item.url.startsWith('https:') && <span class="ab-sr-only">(opens the annual report in a new tab)</span>}</a>)}</div><p class="ab-feedback-note">For general feedback, use our contact page. Please do not submit confidential case details through the website form.</p></div></section>

  <section class="ab-partnership ab-shell" aria-labelledby="partnership-heading"><div><p class="ab-kicker">WORKING TOGETHER</p><h2 id="partnership-heading">Stronger through partnership.</h2><p>Our work is strengthened by communities, Church structures, government institutions, civil society, humanitarian actors and development partners.</p></div><a class="ab-button" href="/#resources">Our partners <Icon name="arrow"/></a></section>

  <section class="ab-cta" aria-labelledby="cta-heading"><img src="/assets/about/peace-conference.jpg" alt="Participants coming together at the JDPI peace conference" width="796" height="358" loading="lazy"/><div><p class="ab-kicker">TOGETHER, WE GO FURTHER</p><h2 id="cta-heading">Together, dignity<br/>becomes action.</h2><p>Discover how we are working alongside communities across Northeast Nigeria.</p><div class="ab-cta-actions"><a class="ab-button ab-button-light" href="/projects/">Explore our work <Icon name="arrow"/></a><a class="ab-button ab-button-outline" href="/impact/">View our impact <Icon name="arrow"/></a></div></div></section>
  <script>import '../../scripts/about-navigation';</script>
</Layout>
