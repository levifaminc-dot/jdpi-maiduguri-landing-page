---
import {pageEditor} from "../../lib/page-editor";
import {getContent} from '../../lib/content';
import {getPublishedResources} from '../../lib/resources';
import {timeline as defaultTimeline,values as defaultValues,approach as defaultApproach,leadership as defaultLeadership} from '../../data/about';
import map from '../../data/about-map.json';
import Layout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/ProjectIcon.astro';
import '../../styles/project-directory.css';
import '../../styles/about.css';
const content=await getContent();
const page=pageEditor(content,"about");
const timeline=page.data('timeline',defaultTimeline);
const values=page.data('values',defaultValues);
const approach=page.data('approach',defaultApproach);
const leadership=page.data('leadership',defaultLeadership.map(person=>({...person,image:{url:`/assets/about/${person.image}.jpg`,alt:person.name}})));
const offices=pageEditor(content,'where-we-work').data('offices',[{town:'Maiduguri',state:'Borno State',type:'Headquarters'},{town:'Mubi',state:'Adamawa State',type:'Office base'},{town:'Potiskum',state:'Yobe State',type:'Office base'}]);
const report=getPublishedResources(content).find(item=>item.title==='JDPI Annual Report 2025');
const reportPage=(page:number)=>`${report?.fileUrl || '/resources/'}#page=${page}`;
const sectionLinks=[
  ['Who We Are','who-heading'],['Our Story','story-heading'],['Mission & Values','guides-heading'],
  ['Our Identity','identity-heading'],['Where We Work','where-heading'],['Our Approach','approach-heading'],
  ['Leadership','leadership-heading'],['Accountability','accountability-heading'],
  ['Partnerships','partnership-heading'],['Our Work','cta-heading'],
];
const accountabilityCopy=page.data<Record<string,{title:string;text:string}>>('accountability',{});
const accountability=[
  {title:'Safeguarding',text:'Protecting dignity, safety and wellbeing.',url:reportPage(59)},
  {title:'Community accountability',text:'Listening, learning and responding.',url:reportPage(58)},
  {title:'Feedback & enquiries',text:'Get in touch with our team.',url:'/contact/'},
  {title:'Financial transparency',text:'Explore our published reports.',url:'/resources/'},
].map((item,index)=>({...item,...accountabilityCopy[['safeguarding','community','feedback','transparency'][index]]}));
---
<Layout content={content} title={`${page.text("seoTitle")} | ${content.settings.shortName}`} description={page.text("seoDescription")} pageClass="projects-page about-page">
  <section class="ab-hero" aria-labelledby="about-heading">
    <img class="ab-hero-image" src={page.image("aboutImage1").url} alt={page.image("aboutImage1").alt} width="796" height="358" fetchpriority="high"/>
    <div class="ab-shell ab-hero-copy"><p class="ab-kicker">{page.text("aboutParagraph1")}</p><h1 id="about-heading">{page.text("aboutHeading1")}<br/><span>{page.text("aboutText1")}<br class="ab-mobile-break"/> {page.text("aboutText2")}</span></h1><p>{page.text("aboutParagraph2")}</p><nav class="ab-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">About Us</span></nav></div>
  </section>

  <nav class="ab-section-nav" aria-label="About page sections"><div class="ab-shell">{sectionLinks.map(([label,id],index)=><a href={`#${id}`} aria-current={index===0?'location':undefined}>{label}</a>)}</div></nav>

  <section class="ab-section ab-shell ab-who" aria-labelledby="who-heading"><div><p class="ab-kicker">{page.text("whoParagraph1")}</p><h2 id="who-heading">{page.text("whoHeading1")}<br/>{page.text("whoHeading2")}</h2><p>{page.text("whoParagraph2")}</p><p>{page.text("whoParagraph3")}</p><p>{page.text("whoParagraph4")}</p><strong class="ab-promise">{page.text("whoText1")}</strong></div><figure class="ab-who-photo"><img src={page.image("whoImage1").url} alt={page.image("whoImage1").alt} width="395" height="216" loading="lazy"/><figcaption>{page.text("whoCaption1")}</figcaption><div class="ab-photo-note"><strong>{page.text("whoText2")}</strong><span>{page.text("whoText3")}</span></div></figure></section>

  <section class="ab-story ab-section" aria-labelledby="story-heading"><div class="ab-shell"><p class="ab-kicker">{page.text("storyParagraph1")}</p><h2 id="story-heading">{page.text("storyHeading1")}<br class="ab-mobile-break"/> {page.text("storyHeading2")}</h2><p class="ab-section-intro">{page.text("storyParagraph2")}</p><ol class="ab-timeline">{timeline.map(item=><li><span class="ab-timeline-dot" aria-hidden="true"></span><strong>{item.year}</strong><h3>{item.title}</h3><p>{item.text}</p></li>)}</ol></div></section>

  <section class="ab-section ab-shell" aria-labelledby="guides-heading"><p class="ab-kicker">{page.text("guidesParagraph1")}</p><h2 id="guides-heading">{page.text("guidesHeading1")}<br class="ab-mobile-break"/> {page.text("guidesHeading2")}</h2><div class="ab-purpose-grid"><article class="ab-mission"><span class="ab-purpose-icon"><Icon name="protection"/></span><div><h3>{page.text("guidesHeading3")}</h3><p>{page.text("guidesParagraph2")}</p></div></article><article class="ab-vision"><span class="ab-purpose-icon"><Icon name="peace"/></span><div><h3>{page.text("guidesHeading4")}</h3><p>{page.text("guidesParagraph3")}</p></div></article></div><h3 class="ab-values-heading">{page.text("guidesHeading5")}</h3><div class="ab-values">{values.map(value=><article><h4>{value.title}</h4><p>{value.text}</p></article>)}</div></section>

  <section class="ab-identity" aria-labelledby="identity-heading"><div class="ab-shell ab-identity-grid"><div><p class="ab-kicker">{page.text("identityParagraph1")}</p><h2 id="identity-heading">{page.text("identityHeading1")}<br/>{page.text("identityHeading2")}</h2><p>{page.text("identityParagraph2")}</p><p>{page.text("identityParagraph3")}</p><div class="ab-identity-seal"><span aria-hidden="true">✝</span><span>{content.settings.diocese}<small>{page.text("identityText1")}</small></span></div></div><figure><img src={page.image("identityImage1").url} alt={page.image("identityImage1").alt} width="951" height="455" loading="lazy"/><figcaption>{page.text("identityCaption1")}</figcaption></figure></div></section>

  <section class="ab-section ab-shell" aria-labelledby="where-heading"><p class="ab-kicker">{page.text("whereParagraph1")}</p><h2 id="where-heading">{page.text("whereHeading1")}</h2><p class="ab-section-intro">{page.text("whereParagraph2")}</p><div class="ab-coverage-grid"><figure class="ab-map"><svg viewBox="0 0 440 410" role="img" aria-labelledby="ab-map-title ab-map-description"><title id="ab-map-title">JDPI’s three states of operation</title><desc id="ab-map-description">Geographically aligned boundaries of Yobe, Borno and Adamawa in Northeast Nigeria. State coverage, not individual project sites.</desc>{map.states.map(state=><g><path d={state.path} class={`ab-state ab-state-${state.name.toLowerCase()}`} fill-rule="evenodd"/><text x={state.label[0]} y={state.label[1]} text-anchor="middle">{state.name}</text></g>)}</svg><figcaption>{page.text("whereCaption1")} <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">{page.text("whereLinkLabel1")}</a></figcaption></figure><div class="ab-offices"><h3>{page.text("whereHeading2")}</h3><ul>{offices.map(({town:name,state,type})=><li><Icon name="location"/><div><strong>{name}</strong><span>{type} · {state.replace(' State','')}</span></div></li>)}</ul><a class="ab-text-link" href="/contact/#office-heading">{page.text("whereLinkLabel2")} <Icon name="arrow"/></a></div><div class="ab-coverage-copy"><p>{page.text("whereParagraph3")}</p><p>{page.text("whereParagraph4")}</p><a class="ab-button" href="/where-we-work/">{page.text("whereLinkLabel3")} <Icon name="arrow"/></a></div></div></section>

  <section class="ab-approach ab-section" aria-labelledby="approach-heading"><div class="ab-shell"><p class="ab-kicker">{page.text("approachParagraph1")}</p><h2 id="approach-heading">{page.text("approachHeading1")}<br/>{page.text("approachHeading2")}</h2><div class="ab-approach-grid">{approach.map((item,index)=><article><span class="ab-approach-number" aria-hidden="true">0{index+1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>

  <section class="ab-section ab-shell" aria-labelledby="leadership-heading"><header class="ab-heading-row"><div><p class="ab-kicker">{page.text("leadershipParagraph1")}</p><h2 id="leadership-heading">{page.text("leadershipHeading1")}</h2><p class="ab-section-intro">{page.text("leadershipParagraph2")}</p></div><span class="ab-year-note">{page.text("leadershipText1")}<br/><strong>{page.text("leadershipText2")}</strong></span></header><div class="ab-leadership-grid">{leadership.map(person=><article class="ab-person"><img src={person.image.url} alt={person.image.alt} width="250" height="250" loading="lazy"/><div><h3>{person.name}</h3><p>{person.role}</p><span>{person.detail}</span></div></article>)}<aside class="ab-team-card"><img src={page.image("leadershipImage1").url} alt={page.image("leadershipImage1").alt} width="762" height="408" loading="lazy"/><div><h3>{page.text("leadershipHeading2")}<br/>{page.text("leadershipHeading3")}</h3><p>{page.text("leadershipParagraph3")}</p><a class="ab-text-link" href="/team/">{page.text("leadershipLinkLabel1")} <Icon name="arrow"/></a></div></aside></div></section>

  <section class="ab-accountability ab-section" aria-labelledby="accountability-heading"><div class="ab-shell"><p class="ab-kicker">{page.text("accountabilityParagraph1")}</p><h2 id="accountability-heading">{page.text("accountabilityHeading1")}</h2><p class="ab-section-intro">{page.text("accountabilityParagraph2")}</p><div class="ab-accountability-links">{accountability.map(item=><a href={item.url} target={item.url.startsWith('https:')?'_blank':undefined} rel={item.url.startsWith('https:')?'noopener noreferrer':undefined}><div><h3>{item.title}</h3><p>{item.text}</p></div><Icon name="arrow"/>{item.url.startsWith('https:') && <span class="ab-sr-only">(opens the annual report in a new tab)</span>}</a>)}</div><p class="ab-feedback-note">{page.text("accountabilityParagraph3")}</p></div></section>

  <section class="ab-partnership ab-shell" aria-labelledby="partnership-heading"><div><p class="ab-kicker">{page.text("partnershipParagraph1")}</p><h2 id="partnership-heading">{page.text("partnershipHeading1")}</h2><p>{page.text("partnershipParagraph2")}</p></div><a class="ab-button" href="/#resources">{page.text("partnershipLinkLabel1")} <Icon name="arrow"/></a></section>

  <section class="ab-cta" aria-labelledby="cta-heading"><img src={page.image("ctaImage1").url} alt={page.image("ctaImage1").alt} width="796" height="358" loading="lazy"/><div><p class="ab-kicker">{page.text("ctaParagraph1")}</p><h2 id="cta-heading">{page.text("ctaHeading1")}<br/>{page.text("ctaHeading2")}</h2><p>{page.text("ctaParagraph2")}</p><div class="ab-cta-actions"><a class="ab-button ab-button-light" href="/projects/">{page.text("ctaLinkLabel1")} <Icon name="arrow"/></a><a class="ab-button ab-button-outline" href="/impact/">{page.text("ctaLinkLabel2")} <Icon name="arrow"/></a></div></div></section>
  <script>import '../../scripts/about-navigation';</script>
</Layout>
