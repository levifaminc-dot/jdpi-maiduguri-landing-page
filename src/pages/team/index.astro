---
import {getContent} from '../../lib/content';
import {getResourceLibrary} from '../../lib/resources';
import team from '../../data/team.json';
import Layout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/ProjectIcon.astro';
import '../../styles/project-directory.css';
import '../../styles/people-places.css';
const content=await getContent();
const report=getResourceLibrary(content.reports).find(item=>item.title==='JDPI Annual Report 2025');
---
<Layout content={content} title={`Our Team | ${content.settings.shortName}`} description="Meet JDPI’s Board of Trustees and management team, as listed in the 2025 annual report." pageClass="projects-page people-place-page team-page">
  <section class="pp-hero" aria-labelledby="team-heading"><div class="pp-hero-copy"><nav class="pp-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/about/">About Us</a><span>/</span><span aria-current="page">Our Team</span></nav><p class="pp-kicker">OUR PEOPLE</p><h1 id="team-heading">A shared purpose.<br/><span>A team in service.</span></h1><p>From strategic oversight to work in the field, our people bring commitment, local knowledge and care to JDPI’s mission.</p><a class="pp-button pp-light" href="#board-heading">Meet our people <Icon name="arrow"/></a></div><figure><img src="/assets/about/maiduguri-team.jpg" alt="JDPI staff gathered at the head office in Maiduguri" width="1200" height="575" fetchpriority="high"/><figcaption>JDPI head-office staff · Annual Report 2025, page 60</figcaption></figure></section>
  <nav class="pp-section-links project-shell" aria-label="Team page sections"><a href="#board-heading">Board of Trustees</a><a href="#management-heading">Management & key staff</a><a href="#people-heading">Our wider team</a></nav>
  <div class="project-shell"><p class="pp-report-note"><strong>As listed in the 2025 Annual Report.</strong> Names, roles and portraits below reflect the report’s roster, rather than an independently confirmed current staff directory. <a href={`${report?.fileUrl || '/resources/'}#page=63`} target="_blank" rel="noopener noreferrer">Read the source ↗</a></p></div>
  <section class="pp-section project-shell" aria-labelledby="board-heading"><header class="pp-heading"><div><p class="pp-kicker">GOVERNANCE & OVERSIGHT</p><h2 id="board-heading">Our Board of Trustees.</h2></div><p>Providing strategic direction, governance and accountability to JDPI’s mission and the communities we serve.</p></header><div class="pp-board-grid">{team.board.map(person=><article class="pp-person"><div class="pp-portrait"><img src={`/assets/team/${person.image}.jpg`} alt={person.name} width="650" height="650" loading="lazy" decoding="async"/></div><div class="pp-person-copy"><p>{person.role}</p><h3>{person.name}</h3>{person.detail&&<span>{person.detail}</span>}</div></article>)}</div><p class="pp-source">Names, roles and portraits: JDPI Annual Report 2025, page 63.</p></section>
  <section class="pp-management-band" aria-labelledby="management-heading"><div class="project-shell pp-section"><header class="pp-heading"><div><p class="pp-kicker">LEADERSHIP IN ACTION</p><h2 id="management-heading">Management & key staff.</h2></div><p>Connecting programmes, operations and organisational systems so that commitments become practical, accountable action.</p></header><div class="pp-staff-grid">{team.management.map(person=><article class="pp-person"><div class="pp-portrait"><img src={`/assets/team/${person.image}.jpg`} alt={person.name} width="650" height="650" loading="lazy" decoding="async"/></div><div class="pp-person-copy"><p>{person.role}</p><h3>{person.name}</h3></div></article>)}</div><p class="pp-source">Names, roles and portraits: JDPI Annual Report 2025, page 64.</p></div></section>
  <section class="pp-section project-shell pp-wider-team" aria-labelledby="people-heading"><figure><img src="/assets/projects/allright-stakeholder-workshop.jpg" alt="JDPI colleagues and stakeholders working together at an ALLRight workshop" width="762" height="408" loading="lazy"/><figcaption>Collaboration at an ALLRight stakeholder workshop · Annual Report 2025</figcaption></figure><div><p class="pp-kicker">BEYOND THE DIRECTORY</p><h2 id="people-heading">People make the difference.</h2><p>Our wider team works across programmes, office bases and communities. The report describes investment in technical training, safeguarding, staff wellbeing and continuous learning.</p><dl class="pp-people-stats"><div><dt>Staff in 2025</dt><dd>123</dd></div><div><dt>Staff trained during the year</dt><dd>47</dd></div></dl><p class="pp-source">Annual Report 2025, page 60 · historical staff snapshot.</p><a class="pp-text-link" href="/contact/">Contact our team →</a></div></section>
  <section class="pp-team-cta"><div class="project-shell"><div><p class="pp-kicker">ONE TEAM. ONE COMMITMENT.</p><h2>Upholding the dignity<br/>of every human person.</h2></div><a class="pp-button pp-light" href="/where-we-work/">Where we work <Icon name="arrow"/></a></div></section>
</Layout>
