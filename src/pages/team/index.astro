---
import {pageEditor} from "../../lib/page-editor";
import {getContent} from '../../lib/content';
import {getPublishedResources} from '../../lib/resources';
import defaultTeam from '../../data/team.json';
import Layout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/ProjectIcon.astro';
import '../../styles/project-directory.css';
import '../../styles/people-places.css';
const content=await getContent();
const page=pageEditor(content,"team");
const person=(item:{name:string;role:string;detail?:string;image:string})=>({...item,image:{url:`/assets/team/${item.image}.jpg`,alt:item.name}});
const team={board:page.data('board',defaultTeam.board.map(person)),management:page.data('management',defaultTeam.management.map(person))};
const report=getPublishedResources(content).find(item=>item.title==='JDPI Annual Report 2025');
---
<Layout content={content} title={`${page.text("seoTitle")} | ${content.settings.shortName}`} description={page.text("seoDescription")} pageClass="projects-page people-place-page team-page">
  <section class="pp-hero" aria-labelledby="team-heading"><div class="pp-hero-copy"><nav class="pp-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/about/">About Us</a><span>/</span><span aria-current="page">Our Team</span></nav><p class="pp-kicker">{page.text("teamParagraph1")}</p><h1 id="team-heading">{page.text("teamHeading1")}<br/><span>{page.text("teamText1")}</span></h1><p>{page.text("teamParagraph2")}</p><a class="pp-button pp-light" href="#board-heading">{page.text("teamLinkLabel1")} <Icon name="arrow"/></a></div><figure><img src={page.image("teamImage1").url} alt={page.image("teamImage1").alt} width="1200" height="575" fetchpriority="high"/><figcaption>{page.text("teamCaption1")}</figcaption></figure></section>
  <nav class="pp-section-links project-shell" aria-label="Team page sections"><a href="#board-heading">Board of Trustees</a><a href="#management-heading">Management & key staff</a><a href="#people-heading">Our wider team</a></nav>
  <div class="project-shell"><p class="pp-report-note"><strong>{page.text("introText1")}</strong> {page.text("introParagraph1")} <a href={`${report?.fileUrl || '/resources/'}#page=63`} target="_blank" rel="noopener noreferrer">{page.text("introLinkLabel1")}</a></p></div>
  <section class="pp-section project-shell" aria-labelledby="board-heading"><header class="pp-heading"><div><p class="pp-kicker">{page.text("boardParagraph1")}</p><h2 id="board-heading">{page.text("boardHeading1")}</h2></div><p>{page.text("boardParagraph2")}</p></header><div class="pp-board-grid">{team.board.map(person=><article class="pp-person"><div class="pp-portrait"><img src={person.image.url} alt={person.image.alt} width="650" height="650" loading="lazy" decoding="async"/></div><div class="pp-person-copy"><p>{person.role}</p><h3>{person.name}</h3>{person.detail&&<span>{person.detail}</span>}</div></article>)}</div><p class="pp-source">{page.text("boardParagraph3")}</p></section>
  <section class="pp-management-band" aria-labelledby="management-heading"><div class="project-shell pp-section"><header class="pp-heading"><div><p class="pp-kicker">{page.text("managementParagraph1")}</p><h2 id="management-heading">{page.text("managementHeading1")}</h2></div><p>{page.text("managementParagraph2")}</p></header><div class="pp-staff-grid">{team.management.map(person=><article class="pp-person"><div class="pp-portrait"><img src={person.image.url} alt={person.image.alt} width="650" height="650" loading="lazy" decoding="async"/></div><div class="pp-person-copy"><p>{person.role}</p><h3>{person.name}</h3></div></article>)}</div><p class="pp-source">{page.text("managementParagraph3")}</p></div></section>
  <section class="pp-section project-shell pp-wider-team" aria-labelledby="people-heading"><figure><img src={page.image("peopleImage1").url} alt={page.image("peopleImage1").alt} width="762" height="408" loading="lazy"/><figcaption>{page.text("peopleCaption1")}</figcaption></figure><div><p class="pp-kicker">{page.text("peopleParagraph1")}</p><h2 id="people-heading">{page.text("peopleHeading1")}</h2><p>{page.text("peopleParagraph2")}</p><dl class="pp-people-stats"><div><dt>{page.text("peopleText1")}</dt><dd>{page.text("peopleText2")}</dd></div><div><dt>{page.text("peopleText3")}</dt><dd>{page.text("peopleText4")}</dd></div></dl><p class="pp-source">{page.text("peopleParagraph3")}</p><a class="pp-text-link" href="/contact/">{page.text("peopleLinkLabel1")}</a></div></section>
  <section class="pp-team-cta"><div class="project-shell"><div><p class="pp-kicker">{page.text("introParagraph2")}</p><h2>{page.text("introHeading1")}<br/>{page.text("introHeading2")}</h2></div><a class="pp-button pp-light" href="/where-we-work/">{page.text("introLinkLabel2")} <Icon name="arrow"/></a></div></section>
</Layout>
