---
import {getContent,safeExternalUrl} from '../../lib/content';
import contactConfig from '../../../config/contact.json';
import Layout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/ProjectIcon.astro';
import '../../styles/project-directory.css';
import '../../styles/contact-impact.css';
import '../../styles/contact-form.css';
const content=await getContent();
const {settings}=content;
const socials=settings.socialLinks.filter(link=>safeExternalUrl(link.url));
const formEndpoint=`https://formsubmit.co/${contactConfig.recipient}`;
const confirmationUrl=new URL('/contact/thanks/',Astro.url.origin).href;
const emailFor=(subject:string)=>`mailto:${settings.email}?subject=${encodeURIComponent(subject)}`;
---
<Layout content={content} title={`Contact Us | ${settings.shortName}`} description="Send JDPI Maiduguri a message, get a response within 24 hours, and find directions to our Maiduguri office." pageClass="projects-page contact-page">
  <div class="project-shell contact-content modern-contact">
    <nav class="ci-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Contact</span></nav>
    <header class="contact-page-heading"><p class="ci-eyebrow">CONTACT JDPI</p><h1 id="contact-heading">Get in <span>touch.</span></h1><p>Have a question, a partnership idea or something to share? We’d like to hear from you.</p></header>
    <div class="contact-workspace">
      <aside class="contact-details" aria-labelledby="contact-details-heading">
        <div><p class="contact-panel-kicker">LET’S CONNECT</p><h2 id="contact-details-heading">Here to listen.<br/>Ready to collaborate.</h2><p>Connect with our team about our work with communities across Northeast Nigeria.</p></div>
        <div class="contact-details-list">
          <article><span class="contact-detail-icon" aria-hidden="true">@</span><div><h3>Email us</h3><a href={`mailto:${settings.email}`}>{settings.email}</a></div></article>
          <article><svg class="contact-detail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m6 3 3 5-2 2c1.5 3 3.5 5 6.5 6.5l2-2 5 3c0 2-1.5 3.5-3.5 3.5C10 21 3 14 3 6.5 3 4.5 4.5 3 6 3Z"/></svg><div><h3>Call our team</h3><a href={`tel:${settings.phone.replace(/[^+\d]/g,'')}`}>{settings.phone}</a></div></article>
          <article><span class="contact-detail-icon"><Icon name="location"/></span><div><h3>Visit our office</h3><address>{settings.address}<br/>{settings.country}</address><a class="contact-visit-link" href="#office-heading">Map &amp; directions</a></div></article>
        </div>
        <div class="contact-panel-bottom"><p>{settings.diocese}</p><p>{settings.tagline}</p>{socials.length>0 && <div class="contact-panel-socials">{socials.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>)}</div>}</div>
      </aside>
      <section class="contact-form-panel" aria-labelledby="enquiry-heading">
        <div class="contact-form-heading"><h2 id="enquiry-heading">Send us a message</h2><p class="contact-response-time">We respond to general enquiries within 24 hours.</p><p>Fields marked <span aria-hidden="true">*</span> are required.</p></div>
        <form id="contact-form" action={formEndpoint} method="POST" aria-describedby="contact-data-note">
          <input type="hidden" name="_subject" value="JDPI website — new contact enquiry"/>
          <input type="hidden" name="_template" value="table"/>
          <input type="hidden" name="_next" value={confirmationUrl}/>
          <input type="hidden" name="source" value="JDPI Maiduguri website contact form"/>
          <div class="contact-honeypot" aria-hidden="true"><label for="contact-website">Leave this field empty</label><input id="contact-website" name="_honey" type="text" tabindex="-1" autocomplete="off"/></div>
          <div class="contact-field-grid">
            <div class="contact-field"><label for="contact-name">Full name <span aria-hidden="true">*</span></label><input id="contact-name" name="name" type="text" autocomplete="name" placeholder="Your full name" required maxlength="120"/></div>
            <div class="contact-field"><label for="contact-email">Email address <span aria-hidden="true">*</span></label><input id="contact-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required maxlength="254"/></div>
            <div class="contact-field"><label for="contact-organisation">Organisation <span class="contact-optional">(optional)</span></label><input id="contact-organisation" name="organisation" type="text" autocomplete="organization" placeholder="Organisation or community" maxlength="160"/></div>
            <div class="contact-field"><label for="contact-topic">Enquiry topic <span aria-hidden="true">*</span></label><select id="contact-topic" name="topic" required><option value="" disabled selected>Select a topic</option><option>General enquiry</option><option>Programmes &amp; projects</option><option>Partnerships &amp; support</option><option>Media &amp; publications</option><option>Volunteering</option><option>Other</option></select></div>
          </div>
          <div class="contact-field contact-message"><label for="contact-message">Your message <span aria-hidden="true">*</span></label><textarea id="contact-message" name="message" rows="5" placeholder="How can we help?" required minlength="10" maxlength="5000" aria-describedby="contact-message-note"></textarea><p id="contact-message-note">Please do not include confidential case details, financial information or other sensitive personal data.</p></div>
          <label class="contact-consent" for="contact-consent"><input id="contact-consent" name="consent" value="I agree to processing my details to respond to this enquiry" type="checkbox" required/><span>I agree to my details being used to respond to this enquiry.</span></label>
          <div class="contact-form-submit"><button class="ci-primary" type="submit">Send message</button><p id="contact-form-status" role="status" aria-live="polite">You may be asked to complete a security check.</p></div>
          <p id="contact-data-note" class="contact-data-note">FormSubmit processes your details and forwards your enquiry to JDPI. After its security check, you’ll return to our confirmation page. <a href="/contact/privacy/">How we handle your enquiry</a>. Prefer email? <a href={`mailto:${settings.email}`}>Contact us directly</a>.</p>
        </form>
      </section>
    </div>
    <aside class="contact-safe-route" aria-labelledby="safe-route-heading"><div><p class="ci-eyebrow">THE RIGHT CHANNEL</p><h2 id="safe-route-heading">Safeguarding or confidential complaints?</h2><p>This form is for general enquiries—not confidential case reporting or emergencies. Please do not send names of affected people, case details or sensitive documents here.</p><p>A dedicated safeguarding reporting channel will be added when confirmed by JDPI. For now, call our team to ask which channel to use, without sharing case details.</p></div><a class="ci-text-link" href={`tel:${settings.phone.replace(/[^+\d]/g,'')}`}>Ask for the appropriate channel →</a></aside>
    <section class="contact-map-section" aria-labelledby="office-heading">
      <div class="contact-map-copy"><p class="ci-eyebrow">FIND US IN MAIDUGURI</p><h2 id="office-heading">Plan your visit.</h2><p>{settings.address}</p><p class="contact-map-note">JDPI has confirmed this map location for our Maiduguri office at St. Patrick’s Catholic Church. Contact us to arrange your visit.</p><div class="contact-map-actions"><a class="ci-primary" href={contactConfig.directionsUrl} target="_blank" rel="noopener noreferrer">Get directions <span class="sr-only">to the JDPI office at St. Patrick’s (opens Google Maps)</span></a><a class="ci-text-link" href={emailFor('Arrange a visit to JDPI Maiduguri')}>Arrange a visit</a></div></div>
      <div class="contact-map-frame"><iframe src={contactConfig.mapEmbedUrl} title="Google Maps: JDPI Maiduguri office at St. Patrick’s Catholic Church" width="700" height="380" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
    </section>
  </div>
</Layout>
<script>
  const contactForm=document.querySelector<HTMLFormElement>('#contact-form');
  const sendButton=contactForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const status=document.querySelector<HTMLElement>('#contact-form-status');
  contactForm?.addEventListener('submit',()=>{
    if(sendButton){sendButton.disabled=true;sendButton.textContent='Continuing…';}
    if(status)status.textContent='Continuing to the secure submission check…';
  });
  window.addEventListener('pageshow',()=>{
    if(sendButton){sendButton.disabled=false;sendButton.textContent='Send message';}
    if(status)status.textContent='You may be asked to complete a security check.';
  });
</script>
