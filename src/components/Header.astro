---
import type {SiteContent} from '../lib/content';
import SocialIcon from './SocialIcon.astro';
import {socialLinks} from '../lib/socials';
interface Props {settings: SiteContent['settings']; home?: boolean}
const {settings, home=false}=Astro.props;
const socials=socialLinks(settings.socialLinks).filter(link=>link.icon);
const anchor=(id:string)=>home ? `#${id}` : `/#${id}`;
const routes:Record<string,string>={'who-we-are':'/about/','what-we-do':'/programmes/',projects:'/projects/',stories:'/stories/',resources:'/resources/',impact:'/impact/',contact:'/contact/'};
const navigation=[['Home','hero'],['About Us','who-we-are'],['Programmes','what-we-do'],['Projects','projects'],['Our Impact','impact'],['Stories & Updates','stories'],['Contact','contact']];
const submenus:Record<string,{label:string;url:string}[]>={
  'who-we-are':[{label:'Our Team',url:'/team/'}],
  impact:[{label:'Where We Work',url:'/where-we-work/'}],
  stories:[{label:'Resources',url:'/resources/'},{label:'Careers',url:'/careers/'}],
};
---
<header class="site-nav" id="main-nav"><div class="nav-inner">
  <a class="brand" href="/" aria-label={`${settings.shortName} home`}><img src="/assets/logo.avif" alt={settings.shortName}/><span class="brand-text"><strong>{settings.organisationName}</strong><span>{settings.diocese}</span></span></a>
  <nav class="nav-links" id="nav-links" aria-label="Primary navigation">
    {navigation.map(([label,id])=>submenus[id] ? <div class="nav-group" data-nav-group data-open="false"><div class="nav-parent"><a href={routes[id]} aria-current={Astro.url.pathname.startsWith(routes[id])?'page':undefined} class:list={[{'nav-ancestor':submenus[id].some(item=>Astro.url.pathname.startsWith(item.url))}]}>{label}</a><button type="button" class="nav-sub-toggle" aria-label={`Show ${label} submenu`} aria-controls={`submenu-${id}`} aria-expanded="false"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 7 5 5 5-5"/></svg></button></div><div class="nav-submenu" id={`submenu-${id}`} aria-label={`${label} submenu`}>{submenus[id].map(item=><a href={item.url} aria-current={Astro.url.pathname.startsWith(item.url)?'page':undefined}>{item.label}</a>)}</div></div> : <a href={routes[id] || anchor(id)} aria-current={routes[id] && Astro.url.pathname.startsWith(routes[id]) ? 'page' : undefined}>{label}</a>)}
    <div class="nav-mobile-socials" role="group" aria-label="JDPI social media">{socials.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`${link.label} — opens in a new tab`} title={link.label}><SocialIcon name={link.icon!}/></a>)}</div>
  </nav>
  <div class="nav-actions">
    <div class="nav-socials" role="group" aria-label="JDPI social media">{socials.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`${link.label} — opens in a new tab`} title={link.label}><SocialIcon name={link.icon!}/></a>)}</div>
    <a class="donate-btn" href="/donate/">DONATE NOW</a>
  </div>
  <button class="menu-toggle" id="menu-toggle" aria-label="Open navigation" aria-controls="nav-links" aria-expanded="false">☰</button>
</div></header>
<script>
  const groups=Array.from(document.querySelectorAll<HTMLElement>('[data-nav-group]'));
  groups.forEach(group=>{
    group.classList.add('is-enhanced');
    const toggle=group.querySelector<HTMLButtonElement>('.nav-sub-toggle');
    const setOpen=(open:boolean)=>{group.dataset.open=String(open);toggle?.setAttribute('aria-expanded',String(open));};
    group.addEventListener('mouseenter',()=>{if(matchMedia('(hover:hover) and (min-width:1101px)').matches)setOpen(true);});
    group.addEventListener('mouseleave',()=>{if(!group.contains(document.activeElement))setOpen(false);});
    toggle?.addEventListener('click',()=>{const open=group.dataset.open!=='true';groups.forEach(other=>{other.dataset.open='false';other.querySelector('.nav-sub-toggle')?.setAttribute('aria-expanded','false');});setOpen(open);});
    group.addEventListener('focusout',event=>{if(!group.contains(event.relatedTarget as Node))setOpen(false);});
    group.addEventListener('keydown',event=>{if(event.key==='Escape'&&group.dataset.open==='true'){event.preventDefault();event.stopPropagation();setOpen(false);toggle?.focus();}if(event.key==='ArrowDown'&&event.target===toggle){event.preventDefault();setOpen(true);group.querySelector<HTMLAnchorElement>('.nav-submenu a')?.focus();}});
    group.querySelectorAll('.nav-submenu a').forEach(link=>link.addEventListener('click',()=>setOpen(false)));
    document.addEventListener('click',event=>{if(!group.contains(event.target as Node))setOpen(false);});
  });
</script>
<style is:global>
  /* Donate is the primary action; social links stay secondary beside it. */
  #main-nav .brand{min-width:0}
  #main-nav .brand-text{display:none}
  #main-nav .nav-actions{display:flex;align-items:center;gap:16px;flex-shrink:0}
  #main-nav .nav-socials{display:flex;align-items:center;gap:6px;padding-right:16px;border-right:1px solid var(--line);color:var(--muted)}
  #main-nav .nav-socials a{display:inline-flex;align-items:center;justify-content:center;width:24px;height:32px;border-radius:3px;transition:background-color .2s,color .2s}
  #main-nav .nav-socials svg{width:15px;height:15px}
  #main-nav .nav-socials a:hover{background:#edf5ed;color:var(--green)}
  #main-nav .nav-socials a:focus-visible{outline:2px solid var(--green);outline-offset:2px}
  #main-nav .nav-actions .donate-btn{display:inline-flex;margin-left:0;min-height:48px;padding:12px 22px;font-size:.875rem}
  #main-nav .nav-mobile-socials{display:none}
  /* Preserve readable navigation and full-size giving, not a squeezed icon row. */
  @media(max-width:1359px){#main-nav .nav-socials{display:none}}
  #main-nav .nav-group{position:relative}
  #main-nav .nav-parent{display:flex;align-items:center;gap:6px}
  #main-nav .nav-sub-toggle{border:0;background:transparent;color:var(--green);padding:0;display:grid;place-items:center;width:22px;min-height:44px;cursor:pointer}
  #main-nav .nav-sub-toggle svg{width:16px;height:16px;transition:transform .2s}
  #main-nav .nav-group[data-open="true"] .nav-sub-toggle svg{transform:rotate(180deg)}
  #main-nav .nav-submenu{display:none;position:absolute;top:100%;left:-16px;min-width:200px;background:#fff;padding:8px;border:1px solid var(--line);border-top:3px solid var(--green);box-shadow:0 12px 28px #00352618;border-radius:0 0 5px 5px}
  #main-nav .nav-group[data-open="true"] .nav-submenu{display:block}
  #main-nav .nav-group:not(.is-enhanced):focus-within .nav-submenu{display:block}
  #main-nav .nav-submenu a{display:block!important;padding:12px!important;font-size:.8125rem;min-height:44px;border:0!important;border-radius:3px}
  #main-nav .nav-submenu a::before,#main-nav .nav-submenu a::after{content:none!important}
  #main-nav .nav-submenu a:hover,#main-nav .nav-submenu a[aria-current="page"]{background:#edf5ed}
  #main-nav .nav-ancestor{color:var(--green);font-weight:700}
  @media(max-width:1100px){#main-nav .nav-links.open .nav-group{width:100%}#main-nav .nav-links.open .nav-parent{width:100%}#main-nav .nav-links.open .nav-parent>a{flex:1}#main-nav .nav-links.open .nav-sub-toggle{width:44px;min-height:54px;flex-shrink:0}#main-nav .nav-links.open .nav-submenu{position:static;width:100%;box-shadow:none;border:0;background:#f3f7f1;padding:6px 14px;margin-bottom:8px}#main-nav .nav-links.open .nav-submenu a{font-size:.9375rem}}
  /* WordPress-inspired corner frames without changing navigation spacing. */
  #main-nav .nav-links:not(.open) a{position:relative;display:inline-flex;align-items:center;min-height:44px;transition:color .4s}
  #main-nav .nav-links:not(.open) a::before,
  #main-nav .nav-links:not(.open) a::after{content:"";position:absolute;box-sizing:border-box;pointer-events:none;width:6px;height:6px;background:transparent;border:2px solid var(--green);opacity:0;transition:opacity .2s,width .4s cubic-bezier(.58,.3,.005,1),height .4s cubic-bezier(.58,.3,.005,1)}
  #main-nav .nav-links:not(.open) a::before{top:0;left:-7px;right:auto;bottom:auto;border-right:0;border-bottom:0}
  #main-nav .nav-links:not(.open) a::after{bottom:0;right:-7px;top:auto;left:auto;border-left:0;border-top:0}
  #main-nav .nav-links:not(.open) a:is(:focus-visible,[aria-current="page"]){color:var(--green)}
  #main-nav .nav-links:not(.open) a:is(:focus-visible,[aria-current="page"])::before,
  #main-nav .nav-links:not(.open) a:is(:focus-visible,[aria-current="page"])::after{opacity:1;width:calc(100% + 14px);height:100%}
  #main-nav .donate-btn{transition:background-color .3s,border-color .3s}
  #main-nav .donate-btn:focus-visible{background:var(--green-dark);border-color:var(--green-dark)}
  @media(hover:hover){
    #main-nav .nav-links:not(.open) a:hover{color:var(--green)}
    #main-nav .nav-links:not(.open) a:hover::before,
    #main-nav .nav-links:not(.open) a:hover::after{opacity:1;width:calc(100% + 14px);height:100%}
    #main-nav .donate-btn:hover{background:var(--green-dark);border-color:var(--green-dark)}
  }
  /* Touch menus keep a simple current-page indicator instead of hover frames. */
  #main-nav .nav-links.open a::before,#main-nav .nav-links.open a::after{content:none}
  #main-nav .nav-links.open a[aria-current="page"]{color:var(--green);font-weight:700}
  #main-nav{--header-menu-top:73px}
  .home-refinement #main-nav{--header-menu-top:84px}
  .projects-page #main-nav{--header-menu-top:76px}
  @media(max-width:1100px){
    #main-nav .nav-links:not(.open){display:none}
    #main-nav .nav-inner{gap:12px}
    #main-nav .nav-actions{gap:0}
    #main-nav .nav-actions .donate-btn{min-height:44px;padding:10px 12px;font-size:.75rem}
    #main-nav .menu-toggle{display:block;min-width:44px;min-height:44px;padding:8px}
    .menu-open #main-nav .nav-actions{visibility:hidden}
    #main-nav .nav-links.open{display:flex;position:fixed;inset:var(--header-menu-top) 0 0;background:#fff;flex-direction:column;align-items:flex-start;padding:2rem;gap:0;width:100%;z-index:101;overflow:auto}
    #main-nav .nav-links.open a{display:block;width:100%;padding:1rem 0;border-bottom:1px solid var(--line);font-size:1rem}
    #main-nav .nav-links.open .nav-mobile-socials{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px;color:var(--green-dark)}
    #main-nav .nav-links.open .nav-mobile-socials a{display:inline-flex;align-items:center;justify-content:center;width:44px;min-height:44px;padding:10px;border:1px solid var(--line);border-radius:4px}
    #main-nav .nav-mobile-socials svg{width:20px;height:20px}
  }
  @media(max-width:780px){
    #main-nav,.projects-page #main-nav{--header-menu-top:68px}
    .home-refinement #main-nav{--header-menu-top:76px}
  }
  @media(max-width:380px){#main-nav .brand img{width:80px}}
  @media(prefers-reduced-motion:reduce){
    #main-nav .nav-links a,#main-nav .nav-links a::before,#main-nav .nav-links a::after,#main-nav .donate-btn,#main-nav .nav-socials a{transition:none}
  }
</style>
