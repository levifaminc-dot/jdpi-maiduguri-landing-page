---
import type {SiteContent} from '../lib/content';
interface Props {settings: SiteContent['settings']; home?: boolean}
const {settings, home=false}=Astro.props;
const anchor=(id:string)=>home ? `#${id}` : `/#${id}`;
const navigation=[['About us','who-we-are'],['Our work','what-we-do'],['Projects','projects'],['Stories','stories'],['Get involved','donate'],['Resources','resources']];
---
<header class="site-nav" id="main-nav"><div class="nav-inner">
  <a class="brand" href="/" aria-label={`${settings.shortName} home`}><img src="/assets/logo.avif" alt={settings.shortName}/><span class="brand-text"><strong>{settings.shortName}</strong><span>{settings.diocese}</span></span></a>
  <nav class="nav-links" id="nav-links" aria-label="Primary navigation">{navigation.map(([label,id])=><a href={id==='resources' ? '/resources/' : anchor(id)}>{label}</a>)}<a class="mobile-donate" href="/donate/">Donate</a></nav>
  <a class="donate-btn" href="/donate/">Donate</a>
  <button class="menu-toggle" id="menu-toggle" aria-label="Open navigation" aria-controls="nav-links" aria-expanded="false">☰</button>
</div></header>
