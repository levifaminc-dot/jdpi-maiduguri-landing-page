---
interface Props {value:string}
const {value}=Astro.props;
---
<strong class="count-up"><span class="count-up-accessible">{value}</span><span class="count-up-visible" data-count-up data-count-final={value} aria-hidden="true">{value}</span></strong>
<script>import '../scripts/count-up';</script>
<style>
  .count-up .count-up-visible{display:inline;margin:0;color:inherit;font:inherit;font-variant-numeric:tabular-nums}
  .count-up .count-up-accessible{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>
