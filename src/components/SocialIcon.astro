---
import type {SocialIconName} from '../lib/socials';
interface Props {name:SocialIconName}
const {name}=Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
  {name==='facebook' && <path fill="currentColor" stroke="none" d="M14 21v-8h3l.5-4H14V7c0-1 .3-2 2-2h2V1.5A22 22 0 0 0 15 1c-3 0-5 2-5 5v3H7v4h3v8Z"/>}
  {name==='instagram' && <><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></>}
  {name==='x' && <path d="M4 3h4l12 18h-4L4 3ZM20 3 4 21"/>}
  {name==='linkedin' && <path fill="currentColor" stroke="none" d="M4 8h4v13H4V8ZM6 2a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM11 8h4v2c1-2 6-3 6 3v8h-4v-7c0-3-2-3-2 0v7h-4V8Z"/>}
  {name==='youtube' && <><rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 6 3-6 3Z" fill="currentColor" stroke="none"/></>}
</svg>
