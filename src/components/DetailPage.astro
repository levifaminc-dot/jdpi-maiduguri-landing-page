---
import {PortableText} from 'astro-portabletext';
import type {ContentItem,SiteContent} from '../lib/content';
import {formatDate} from '../lib/content';
import Layout from '../layouts/SiteLayout.astro';
import ContentImage from './ContentImage.astro';
interface Props {item:ContentItem; content:SiteContent; type:'programmes'|'projects'|'stories'}
const {item,content,type}=Astro.props;
const back=type==='programmes' ? '/#what-we-do' : `/${type}/`;
---
<Layout content={content} title={`${item.seoTitle||item.title} | ${content.settings.shortName}`} description={item.seoDescription||item.summary||content.settings.seoDescription}>
  <section class="inner-page"><div class="shell"><a class="back-link" href={back}>Back to {type}</a><h1>{item.title}</h1>
    {item.publishedAt && <p class="story-date">{formatDate(item.publishedAt)}</p>}{item.location && <p>{item.location}</p>}
    {item.summary && <p class="intro">{item.summary}</p>}<ContentImage image={item.image} class="detail-image" eager/>
    {item.imageCaption && <p>{item.imageCaption}</p>}
    {item.body?.length>0 ? <div class="prose"><PortableText value={item.body}/></div> : <p class="intro">For more information about this {type==='stories'?'update':type.slice(0,-1)}, <a class="text-link" href={`mailto:${content.settings.email}`}>contact JDPI</a>.</p>}
  </div></section>
</Layout>
