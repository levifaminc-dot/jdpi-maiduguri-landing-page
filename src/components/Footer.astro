---
import type {SiteContent} from '../lib/content';
import {safeExternalUrl} from '../lib/content';
import ProjectIcon from './ProjectIcon.astro';
import {reportSocials} from '../data/socials';
interface Props {content: SiteContent}
const {settings, programmes}=Astro.props.content;
const quickLinks=[['About Us','/about/'],['Projects','/projects/'],['Our Impact','/impact/'],['Stories & Updates','/stories/']];
const footerProgrammes=programmes.slice(0,3);
const configuredSocials=(settings.socialLinks || []).filter(link=>safeExternalUrl(link.url));
// Keep editor-configured destinations while adding report-verified platforms.
const platform=(url:string)=>new URL(url).hostname.replace(/^www\./,'').replace('twitter.com','x.com');
const socials=[...configuredSocials,...reportSocials.filter(link=>!configuredSocials.some(configured=>platform(configured.url)===platform(link.url)))];
---
<footer id="contact" class="jdpi-footer">
  <div class="jf-shell">
    <div class="jf-grid">
      <div class="jf-brand">
        <a class="jf-logo" href="/" aria-label={`${settings.shortName} home`}><img src="/assets/logo.avif" alt={`${settings.shortName} logo`} width="180" height="90" loading="lazy" decoding="async"/></a>
        <p class="jf-name">{settings.organisationName}</p>
        <p class="jf-diocese">{settings.diocese}</p>
        <p class="jf-tagline">{settings.tagline}</p>
        <a class="jf-support" href="/donate/">Support our work <ProjectIcon name="arrow"/></a>
      </div>
      <nav class="jf-column" aria-labelledby="footer-explore-heading">
        <h2 id="footer-explore-heading">Explore JDPI</h2>
        <ul>{quickLinks.map(([label,url])=><li><a href={url}>{label}</a></li>)}</ul>
      </nav>
      <nav class="jf-column" aria-labelledby="footer-programmes-heading">
        <h2 id="footer-programmes-heading">Our programmes</h2>
        <ul>{footerProgrammes.map(p=><li><a href={`/programmes/${p.slug}/`}>{p.title.toLowerCase().replace(/(^|[\s&])\S/g,letter=>letter.toUpperCase())}</a></li>)}<li><a href="/programmes/">All programmes <span aria-hidden="true">→</span></a></li></ul>
      </nav>
      <div class="jf-column jf-contact">
        <h2>Get in touch</h2>
        <address>
          <div class="jf-contact-line"><ProjectIcon name="location"/><span>{settings.address}<br/>{settings.country}</span></div>
          <a class="jf-contact-line" href={`mailto:${settings.email}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg><span>{settings.email}</span></a>
          <a class="jf-contact-line" href={`tel:${settings.phone.replace(/[^+\d]/g,'')}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 3 3 5-2 2c2 3 4 5 7 7l2-2 5 3c-1 3-3 4-6 3C9 19 5 15 3 9c-1-3 0-5 3-6Z"/></svg><span>{settings.phone}</span></a>
        </address>
        <a class="jf-contact-link" href="/contact/">Send us a message <ProjectIcon name="arrow"/></a>
        <div class="jf-socials" aria-label="JDPI social media">{socials.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`${link.label} — opens in a new tab`} title={link.label}>
          {link.label.toLowerCase().includes('facebook') && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 21v-8h3l.5-4H14V7c0-1 .3-2 2-2h2V1.5A22 22 0 0 0 15 1c-3 0-5 2-5 5v3H7v4h3v8Z"/></svg>}
          {platform(link.url)==='instagram.com' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>}
          {platform(link.url)==='x.com' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 3h4l12 18h-4L4 3ZM20 3 4 21"/></svg>}
          {platform(link.url)==='linkedin.com' && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 8h4v13H4V8ZM6 2a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM11 8h4v2c1-2 6-3 6 3v8h-4v-7c0-3-2-3-2 0v7h-4V8Z"/></svg>}
          <span class="jf-social-label">{link.label}</span>
        </a>)}</div>
      </div>
    </div>
    <div class="jf-bottom"><p>© {new Date().getFullYear()} {settings.shortName}. All rights reserved.</p><div><a href="/resources/">Reports &amp; resources</a><a href="/contact/">Contact our team</a></div></div>
  </div>
</footer>
<style is:global>
  #contact.jdpi-footer{padding:32px 0 0;background:#003526;color:#fff;border-top:4px solid #08783e}
  .jf-shell{width:min(1240px,calc(100% - 80px));margin-inline:auto}
  .jf-grid{display:grid;grid-template-columns:1.25fr .75fr 1.05fr 1.15fr;gap:28px;padding-bottom:24px}
  .jf-brand{min-width:0}
  .jf-logo{display:inline-flex;align-items:center;justify-content:center;background:#fff;border-radius:6px;padding:6px 12px;margin-bottom:14px}
  .jf-logo img{width:146px;height:62px;object-fit:contain}
  .jf-name{font:700 1rem/1.55 Montserrat,sans-serif;max-width:290px;margin:0 0 8px}
  .jf-diocese{font-size:.9375rem;line-height:1.5;color:#d1e4d8;margin:0 0 10px}
  .jf-tagline{font-size:1rem;line-height:1.5;color:#d1e4d8;max-width:265px;margin:0 0 14px}
  .jf-support{display:inline-flex;align-items:center;gap:12px;min-height:44px;border:1px solid #88b69b;border-radius:4px;padding:10px 16px;font-size:.9375rem;font-weight:600;color:#fff;transition:background-color .2s}
  .jf-support:hover{background:#07583c}
  .jf-support svg,.jf-contact-link svg{width:18px;height:18px;flex-shrink:0}
  .jf-column{min-width:0}
  .jf-column h2{font:700 .9375rem/1.5 Montserrat,sans-serif;letter-spacing:.01em;color:#fff;margin:0 0 12px}
  .jf-column ul{padding:0;margin:0;list-style:none;display:grid;gap:0}
  .jf-column li a{display:inline-block;padding:4px 0;color:#d1e4d8;font-size:.9375rem;line-height:1.5;overflow-wrap:anywhere}
  .jf-column a:hover,.jf-bottom a:hover{color:#fff;text-decoration:underline;text-underline-offset:5px}
  .jf-contact address{font-style:normal;font-size:.9375rem;line-height:1.5;display:grid;gap:12px;color:#d1e4d8}
  .jf-contact-line{display:flex;align-items:flex-start;gap:12px;min-width:0;overflow-wrap:anywhere}
  .jf-contact-line svg{width:19px;height:19px;flex-shrink:0;margin-top:4px;color:#a8d7b7}
  .jf-contact-link{display:inline-flex;align-items:center;gap:10px;min-height:44px;margin-top:8px;font-size:.9375rem;font-weight:600;color:#fff}
  .jf-socials{display:flex;flex-wrap:wrap;gap:10px;margin-top:8px}
  .jf-socials a{display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;border:1px solid #55836a;border-radius:4px;padding:10px;font-size:.875rem;color:#d1e4d8}
  .jf-socials svg{width:19px;height:19px}
  .jf-socials a:has(svg) .jf-social-label{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .jf-bottom{display:flex;align-items:center;justify-content:space-between;gap:24px;border-top:1px solid #426d56;padding:12px 0;color:#c5dbcd;font-size:.875rem;line-height:1.6}
  .jf-bottom p{margin:0}
  .jf-bottom>div{display:flex;gap:24px;flex-wrap:wrap}
  .jf-bottom a{display:inline-block;padding:6px 0}
  @media(max-width:1100px){.jf-grid{grid-template-columns:1fr 1fr;gap:24px 32px}}
  @media(max-width:650px){#contact.jdpi-footer{padding-top:28px}.jf-shell{width:calc(100% - 40px)}.jf-grid{grid-template-columns:1fr;gap:24px;padding-bottom:24px}.jf-brand{padding-bottom:22px;border-bottom:1px solid #426d56}.jf-name,.jf-tagline{max-width:350px}.jf-column h2{margin-bottom:8px}.jf-column li a{min-height:44px;padding-block:10px}.jf-column[aria-labelledby="footer-explore-heading"] ul{grid-template-columns:1fr 1fr;gap:0 16px}.jf-contact address{gap:12px}.jf-bottom{display:block;padding-block:16px}.jf-bottom>div{gap:20px;margin-top:6px}.jf-bottom a{min-height:44px;padding-block:10px}}
  @media(prefers-reduced-motion:reduce){.jf-support{transition:none}}
</style>
