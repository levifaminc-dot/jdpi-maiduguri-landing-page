---
import type {ContentItem} from '../lib/content';
import {itemUrl,formatDate} from '../lib/content';
import {programmeImage} from '../lib/programmes';
import ContentImage from './ContentImage.astro';
interface Props {items: ContentItem[]; type: 'programmes'|'projects'|'stories'; carousel?: boolean; focusLabels?: Record<string,string>}
const {items,type,carousel=true,focusLabels={}}=Astro.props;
const tones=['green','yellow','blue','red','purple','teal','orange'];
---
<div class={carousel ? 'carousel' : 'content-grid'} id={carousel ? `${type}-carousel` : undefined}>
{items.map((item,i)=><article class={type==='programmes' ? 'carousel-card' : type==='projects' ? 'project-card' : 'story-card'} data-type={type==='stories' ? item.category : undefined}>
  <ContentImage image={type==='programmes'?programmeImage(item):item.image}/>
  <div class={type==='programmes' ? `card-panel c-${tones[i%tones.length]}` : type==='projects' ? 'project-body' : 'story-body'}>
    {type==='stories' && <p class="story-date">{formatDate(item.publishedAt)}</p>}
    {type==='projects' && focusLabels[item.slug] && <span class="project-focus">{focusLabels[item.slug]}</span>}
    <h3>{item.title}</h3>
    {type==='projects' && item.location && <p class="mini-location">{item.location}</p>}
    {type!=='stories' && <p>{item.summary}</p>}
    <a class={type==='programmes' ? 'arrow' : undefined} href={itemUrl(type,item.slug)} aria-label={`Read ${item.title}`}>{type==='programmes' ? 'EXPLORE PROGRAMME' : type==='projects' ? 'VIEW PROJECT' : 'READ MORE'}</a>
  </div>
</article>)}
</div>
