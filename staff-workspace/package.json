{
  "name": "jdpi-staff-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 4330",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4330",
    "check": "tsc --noEmit",
    "db:plan": "node scripts/migrate-database.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate-database.mjs --apply",
    "db:bootstrap": "node --env-file=.env.local scripts/bootstrap-admin.mjs",
    "db:activate-runtime": "node --env-file=.env.local scripts/initialise-runtime-password.mjs",
    "db:resume-runtime": "node --env-file=.env.local scripts/initialise-runtime-password.mjs --resume",
    "test": "node --conditions=react-server --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.8.1",
    "better-auth": "1.7.7",
    "jose": "6.2.12",
    "next": "16.4.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^24.0.0",
    "@types/pg": "8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3"
  }
}
