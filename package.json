{
  "name": "jdpi-maiduguri-website",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["studio"],
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "check": "astro check && npm run check --workspace studio",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "content:snapshot": "node --env-file-if-exists=.env scripts/snapshot-content.mjs",
    "content:import": "node --env-file-if-exists=.env scripts/import-content.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "studio:dev": "npm run dev --workspace studio",
    "studio:build": "npm run build --workspace studio",
    "studio:verify": "node --env-file-if-exists=studio/.env scripts/verify-studio.mjs",
    "studio:deploy": "npm run deploy --workspace studio",
    "typegen": "npm run typegen --workspace studio",
    "verify": "npm run content:validate && npm run check && npm run build && node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@sanity/astro": "3.5.1",
    "@sanity/client": "7.27.0",
    "@portabletext/types": "^3.0.0",
    "astro": "7.3.5",
    "astro-portabletext": "1.0.1",
    "groq": "6.17.0"
  },
  "devDependencies": {"@astrojs/check": "0.9.10", "typescript": "^5.9.3", "@types/node": "^24.0.0"}
}
